<section class="crt-Cart lyt-Container" data-module="cart">
  <div class="crt-Cart_Inner">

    {%- if cart.item_count == 0 -%}

      <div class="crt-Cart_Empty">
        <h1 class="crt-Cart_Title fz-25_33">{{ 'cart.general.title' | t }}</h1>

        <p class="crt-Cart_Text">{{ 'cart.general.text' | t }}</p>
      </div>

    {%- else -%}

      <div class="crt-Cart_Body">
        <div class="crt-Cart_Main">

          {% comment %}
          <div class="crt-Cart_Meta">
            <p class="crt-Cart_Count fz-12_12">
              Items (<span data-el="cart.count">{{ cart.item_count }}</span>)
            </p>
          </div>
          {% endcomment %}

          <div class="crt-Cart_Products">

            <header class="crt-Cart_Header">
              <h2 class="crt-Cart_Title fz-25_33">
                {{ 'cart.products.title' | t }} (<span data-el="cart.count">{{ cart.item_count }}</span>)
              </h2>
            </header>

            <div class="crt-Products">
              <div class="crt-Products_Items" data-el="cart.itemsContainer">
                {%- for item in cart.items -%}
                  {%- render 'cart-line-item', line_item: item -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>

        <div class="crt-Cart_Summary" data-el="cart.summaryContainer">
          {%- section 'cart-summary' -%}
        </div>
      </div>

      <footer class="crt-Cart_Footer fz-12_12">
        <a
          class="crt-Cart_Link crt-Cart_Link-continue"
          href="{{ routes.collections_url }}"
        >
          {%- render 'bao-chevron-left' -%}
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </footer>
    {%- endif -%}
  </div>
</section>
