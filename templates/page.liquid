<section class="pg-Page lyt-Container">
  <div class="pg-Page_Inner">
    <header class="pg-Page_Header">
      <h1 class="pg-Page_Title fz-25_33">{{ page.title }}</h1>
    </header>

    {%- if page.content != blank -%}
      <div class="pg-Page_Body">
        <div class="pg-Page_Text rte-RichText">
          {{ page.content }}
        </div>
      </div>
    {%- endif -%}

    <div class="pg-Page_Nav">
      {%- section 'page-nav' -%}
    </div>
  </div>
</section>
