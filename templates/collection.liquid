{%- liquid
  assign pagination_amount = 47
  assign has_promoted_item = false
  assign promoted_item_index = null

  if collection.metafields.Promoted.Index != blank and collection.metafields.Promoted.Image != blank
    assign has_promoted_item = true
    assign promoted_item_index = collection.metafields.Promoted.Index | plus: 0
    assign pagination_amount = 47
  endif
-%}
{% capture CFH %}{{ content_for_header }}{% endcapture -%}
{{- CFH }}

{% assign admin = false %}

{% if CFH contains 'previewBarInjector' %}
  <script>
    console.log('cfh contains previewBarInjector', {{ CFH | json }});
  </script>
{% endif %}

{% if CFH contains 'previewBarInjector' %}
  {% assign admin = true %}
{% endif %}

{%- if cart.attributes.pagination != blank -%}
  {%- comment -%} If we do, use this value for the pagination instead {%- endcomment -%}
  {%- assign pagination_amount = cart.attributes.pagination | default: 47 | abs -%}
{%- endif -%}

<section class="clc-Hero{% if collection.image %} clc-Hero-withImage{% endif %} js-Animate" data-animation="Fade">
  <div class="clc-Hero_Inner lyt-Container">
    <div class="clc-Hero_Header">
      <h1 class="clc-Hero_Title fz-25_33">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <div class="clc-Hero_Text fz-13_18">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="clc-Hero_Body">
      {%- if collection.metafields.Image.Mobile_Hero -%}
        <div class="clc-Hero_ImageContainer clc-Hero_ImageContainer-mobile">
          {%- render 'responsive-image-metafield',
            image: collection.metafields.Image.Mobile_Hero.first,
            width: collection.metafields.Image.Mobile_Hero.first.width,
            height: collection.metafields.Image.Mobile_Hero.first.height
          -%}
        </div>
      {%- endif -%}

      {%- if collection.image -%}
        <div class="clc-Hero_ImageContainer{% if collection.metafields.Image.Mobile_Hero %} clc-Hero_ImageContainer-desktop{% endif %}">
          {%- render 'responsive-image', image: collection.image, width: 3252, height: 1777 -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- capture content_string -%}{{ content_for_header }}{%- endcapture -%}
{%- assign page_url = content_string
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}
{% assign url = page_url | split: '/' | last %}
{% if url contains "?" %}
  {% assign url = url | split: '?' | first %}
{% endif %}
{% assign fiter_array = url %}
{% if current_tags != blank and fiter_array contains 'size' %}
  {% if fiter_array contains '+' %}
    {% assign fiter_array_splitted = fiter_array | split: '+' %}
    {% assign fiter_item = '' %}
    {% for fiter_item_i in fiter_array_splitted %}
      {% if fiter_item_i contains 'size' %}
        {% assign fiter_item = fiter_item_i | remove: 'filter-size-' | strip %}
      {% endif %}
    {% endfor %}
    {% if fiter_item == '' %}
      {% assign fiter_item = 'no-filter' %}
    {% endif %}
  {% else %}
    {% assign fiter_item = url | remove: 'filter-size-' | strip %}
  {% endif %}
{% else %}
  {% assign fiter_item = 'no-filter' %}
{% endif %}
<script>
  console.log("Filter by - ",{{ fiter_item | json }});
</script>

{%- paginate collection.products by pagination_amount -%}
  <section class="clc-List">
    <div class="clc-List_Inner lyt-Container">
      <div class="clc-List_Body">
        <div class="prd-List">
          <div
            class="prd-List_Items {% if collection.metafields.custom.enable_load_more %}products-onpage{% endif %}"
            {% if collection.metafields.custom.enable_load_more %}
              next-url="{{ paginate.next.url }}"
            {% endif %}
          >
            {%- for product in collection.products -%}
              {% assign show_product = true %}
              {% if fiter_item != 'no-filter' %}
                {% for variant in product.variants %}
                  {% if variant.title == fiter_item %}
                    {% unless variant.available %}
                      {% assign show_product = false %}
                    {% endunless %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% if show_product %}
                {%- if has_promoted_item and forloop.index == promoted_item_index -%}
                  <div class="prd-List_Item prd-List_Item-span prd-List_Item-promoted" show_product="{{ show_product }}">
                    {%- render 'collection-promoted-card', metafields: collection.metafields.Promoted -%}
                  </div>
                {%- endif -%}

                {%- assign admin_tag = 'ADMIN' -%}
                {%- assign nlos_tag = 'NLOS' -%}
                {% comment %} <script>
                  console.log('customer tags', {{customer.tags | json}});
                  console.log('customer name', {{customer.name | json}});
                </script> {% endcomment %}
                {%- if admin -%}
                  {%- if product.tags contains nlos_tag -%}
                    <!-- {# Do not render products with 'NLOS' tag for customers with 'ADMIN' tag #} -->
                    <div class="prd-List_Item NLOS js-Animate" data-animation="Fade" show_product="{{ show_product }}" fiter_array="{{fiter_array}}">
                      {%- render 'product-card', product: product -%}
                    </div>
                  {%- else -%}
                    <div class="prd-List_Item js-Animate" data-animation="Fade" show_product="{{ show_product }}" fiter_array="{{fiter_array}}">
                      {%- render 'product-card', product: product -%}
                    </div>
                  {%- endif -%}
                {%- else -%}
                  <!-- {# Render products only if they don't have 'NLOS' tag for customers without 'ADMIN' tag #} -->
                  {%- unless product.tags contains nlos_tag -%}
                    <div class="prd-List_Item js-Animate" data-animation="Fade" show_product="{{ show_product }}" fiter_array="{{fiter_array}}">
                      {%- render 'product-card', product: product -%}
                    </div>
                  {%- endunless -%}
                {%- endif -%}
              {% endif %}
            {%- endfor -%}
          </div>
          {% if collection.metafields.custom.enable_load_more %}
            <div class="load-more">
              <a class="btn btn--Primary load-more_btn " href="javascript:void(0);" onclick="loadMoreProducts()">
                Load More
              </a>
              <div class="load-more_spinner" style="display:none;"></div>
            </div>
          {% endif %}
        </div>
      </div>
      {% unless collection.metafields.custom.enable_load_more %}
        <footer class="clc-List_Footer">
          <div class="clc-List_Pagination">
            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          </div>
        </footer>
      {% endunless %}
      <button
        class="clc-Filters_Link fz-10_10"
        type="button"
        data-module-drawers-trigger="clc-filters"
      >
        {{ 'collections.general.filter' | t }}

        <div class="clc-Filters_Icon">
          {%- render 'bao-chevron-left' -%}
        </div>
      </button>
    </div>

    <div
      class="drw-Drawer drw-Drawer-fromRight"
      data-module-drawers-drawer="clc-filters"
      data-module-drawers-move-me="root"
    >
      <button
        class="clc-Filters_Link clc-Filters_Link-drawer fz-10_10"
        type="button"
        data-module-drawers-close="clc-filters"
      >
        {{ 'collections.general.filter_close' | t }}

        <div class="clc-Filters_Icon">
          {%- render 'bao-chevron-right' -%}
        </div>
      </button>

      <div class="drw-Drawer_Inner">
        <header class="drw-Drawer_Header">
          <h2 class="drw-Drawer_Title fz-25_33">{{ 'collections.general.filter_title' | t }}</h2>
        </header>

        <div class="drw-Drawer_Body">
          {%- section 'collection-filters' -%}
        </div>
      </div>
    </div>
  </section>
{%- endpaginate -%}

<script>
  console.log("Customer tags:", {{ customer.tags | json }});
  console.log("name", {{customer.name | json}});
</script>

{% if collection.metafields.custom.enable_load_more %}
  {% style %}
    .load-more {
      text-align: center;
      margin-top: 20px;
      position: relative;
    }
    .load-more_spinner {
      height: 28px;
      width: 28px;
      border: 3px solid #f3f3f3;
      border-top: 3px solid #052e26;
      border-radius: 50%;
      margin-left: auto;
      margin-right: auto;
      animation: spin 2s linear infinite;
    }
    @keyframes spin {
      from {
        transform:rotate(0deg);
      }
      to {
        transform:rotate(360deg);
      }
    }
  {% endstyle %}

  <script>
    const productsOnPage = document.querySelector('.products-onpage');
    let nextUrl = productsOnPage.getAttribute('next-url');

    const loadMoreBtn = document.querySelector('.load-more_btn');
    const loadMoreSpinner = document.querySelector('.load-more_spinner');

    async function loadMoreProducts() {
      if (!nextUrl) return;

      loadMoreBtn.style.display = 'none';
      loadMoreSpinner.style.display = 'block';

      try {
        const response = await fetch(nextUrl);
        const nextPageHTML = await response.text();

        loadMoreSpinner.style.display = 'none';

        // Parse the next page HTML
        const parser = new DOMParser();
        const doc = parser.parseFromString(nextPageHTML, 'text/html');
        const newProducts = doc.querySelector('.products-onpage');

        if (!newProducts) return;

        const newUrl = newProducts.getAttribute('next-url');

        // Append new products
        productsOnPage.insertAdjacentHTML('beforeend', newProducts.innerHTML);

        // Update next URL and button visibility
        nextUrl = newUrl;
        if (nextUrl) {
          loadMoreBtn.style.display = 'inline-block';
        }
      } catch (error) {
        console.error('Error loading more products:', error);
        loadMoreSpinner.style.display = 'none';
        loadMoreBtn.style.display = 'inline-block';
      }
    }
  </script>
{% endif %}
