<!doctype html>
<html class="util-NoJs" lang="{{ shop.locale }}">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1" />
    <meta name="author" content="By Association Only" />
    <link rel="stylesheet" href="https://use.typekit.net/ojr8oqr.css">



    {%- if request.page_type == 'search' -%}
      <meta name="robots" content="noindex">
    {%- endif -%}

    {%- if template contains 'collection' and current_tags -%}
      <meta name="robots" content="noindex, follow" />
      <link rel="canonical" href="{{ shop.url }}{{ collection.url }}" />
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}" />
    {%- endif -%}

    {%- render 'favicons' -%}

    {%- capture seo_title -%}
      {{ page_title }}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' -%} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 -%}
        &ndash; {{ 'general.meta.page' | t: page: current_page }}
      {%- endif -%}
    {%- assign escaped_page_title = page_title | escape -%}
      {%- unless escaped_page_title contains shop.name -%}
        &ndash; {{ shop.name }}
      {%- endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}" />
    {%- endif -%}

    {%- render 'hreflang' -%}
    {%- render 'social-meta-tags' -%}
    {%- render 'variables' -%}
    {%- render 'style-tags', layout: 'theme' -%}
    {%- render 'typography' -%}
    {{ 'custom-global.css' | asset_url | stylesheet_tag }}

    {%- render 'head-script' -%}

    {%- render 'typekit' -%}

    {{ '//cdn.shopify.com/s/shopify/shopify_common.js' | script_tag }}
    {{ '//cdn.shopify.com/s/javascripts/currencies.js' | script_tag }}
    {%- render 'script-tags', layout: 'theme' -%}

    <link href="https://vjs.zencdn.net/7.10.2/video-js.css" rel="stylesheet" />
    <script src="{{ 'custom-fullpage-scroll.js' | asset_url }}" defer="defer"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    {{ content_for_header }}

    {%- render 'klevu-head' -%}

  </head>

  {%- liquid
    assign enable_fullpage_scroll = false

    if template.name == 'index'
      assign enable_fullpage_scroll = true
    elsif template.name == 'product'
      if settings.pdp_scroll_type == 'slider'
        assign enable_fullpage_scroll = true
      endif
    endif
  -%}
  <body
    id="{{ page_title | handle }}"
    class="lyt-Site template-{{ template.name | handle }} thm-{{ settings.theme }} {% if settings.bar_enabled %}thm-AnnouncementBar{% endif %}"
    {%- if enable_fullpage_scroll %}data-fullpage-scroll{%- endif -%}
  >
    <a
      class="util-ScreenReaderOnly"
      href="#MainContent"
    >
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>



    {% comment %} {%- render 'cookie-banner' -%} {% endcomment %}

    <div
      class="lyt-Header js-header-wrapper"
      {% if template.name == 'index' %}data-header-mode="light"{% endif %}
    >
      {%- sections 'header-group' -%}
    </div>

    <main role="main" id="MainContent">
      {{ content_for_layout }}
      {% comment %} {{ content_for_index }} {% endcomment %}
       <div class="shopify-section shopify-section--footer"></div>
    </main>

    {%- sections 'footer-group' -%}

    {%- render 'newsletter-modal' -%}

    {%- render 'drawers' -%}

    <script src="https://vjs.zencdn.net/7.10.2/video.min.js" defer="defer"></script>

    {%- render 'klevu-foot' -%}

    {%- render 'back-in-stock-helper' -%}

    {% comment %} Klaviyo {% endcomment %}
    {%- if shop.permanent_domain == 'solace-london.myshopify.com' -%}
      <script
        async
        type="text/javascript"
        src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=XuEqtQ"
      ></script>
    {%- else -%}
      <script
        async
        type="text/javascript"
        src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=MKZsDF"
      ></script>
    {%- endif -%}

    {% comment %} Zendesk {% endcomment %}
    <!-- Start of solacelondonsupport Zendesk Widget script -->
    <script
      id="ze-snippet"
      src="https://static.zdassets.com/ekr/snippet.js?key=67874f43-97a3-4fb1-8c49-2a5e344d04e0"
    ></script>
    <!-- End of solacelondonsupport Zendesk Widget script -->
  </body>


</html>
