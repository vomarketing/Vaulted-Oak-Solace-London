<div id="MiniBag" class="drw-Drawer drw-Drawer-fromRight mbg-Drawer" data-module-drawers-drawer="cart" data-mini-bag data-root-url="{{ routes.root_url }}" role="dialog" aria-modal="true" aria-labelledby="MiniBagTitle" aria-hidden="true" tabindex="-1">
  <header class="mbg-Header">
    <h2 id="MiniBagTitle">Bag (<span data-mini-count>{{ cart.item_count }}</span>)</h2>
    <button type="button" data-mini-close>Close</button>
  </header>
  <p class="mbg-Error" data-mini-error role="alert" hidden></p>
  <div class="mbg-Live" aria-live="polite" data-mini-live></div>
  <div class="mbg-Content" data-mini-content>{% render 'mini-bag-content' %}</div>
  <div class="mbg-Information" data-mini-information hidden>
    {% if settings.mbg_delivery != blank %}<div>{{ settings.mbg_delivery }}</div>{% endif %}
    {% if shop.shipping_policy.body != blank %}<h3>Shipping</h3><div>{{ shop.shipping_policy.body }}</div>{% endif %}
    {% if shop.refund_policy.body != blank %}<h3>Returns</h3><div>{{ shop.refund_policy.body }}</div>{% endif %}
  </div>
</div>