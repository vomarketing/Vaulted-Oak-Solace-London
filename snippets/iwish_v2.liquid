{%- liquid

  assign wishlist_page_url = "/apps/iwish"
  assign jquery_cdn_url = "https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"
  assign is_collection = false

  if page_type == "collection"
    assign is_collection = true
  else
    assign page_type = "product"
  endif

-%}

{% comment %} Script for head {% endcomment %}
{%- if component == 'head-script' -%}

  {% comment %} Load jQuery for wishlist page - it is required :( {% endcomment %}
  {%- if request.path == wishlist_page_url -%}
    <script type="text/javascript" async="" src="{{- jquery_cdn_url -}}"></script>
  {%- endif -%}

  <script type="text/javascript">

    var iwish_shop = "{{ shop.permanent_domain }}";
    var iwish_pro_template = {% if template contains 'product' %}true{% else %} false{% endif %};
    var iwish_cid = "{{ customer.id }}";
    //Add to Wishlist - Product Page Text
    var iwish_added_txt = "{{- 'wishlist.added_to_wishlist' | t -}}";
    var iwish_add_txt = "{{- 'wishlist.add_to_wishlist' | t -}}";
    //Add to Wishlist - Collection Page Text
    var iwish_added_txt_col = "{{- 'wishlist.added_to_wishlist' | t -}}";
    var iwish_add_txt_col = "{{- 'wishlist.add_to_wishlist' | t -}}";

    window.wishlist = {
      addToWishlist: function(element, variantId) {
        if (!window.SLWishlist) return;
        window.SLWishlist.add(element.dataset.product, variantId, { handle: element.dataset.productHandle, sized: true });
      },
      removeFromWishlist: function(element) {
        if (!window.SLWishlist) return;
        window.SLWishlist.remove(element.dataset.product);
      }
    };

    document.addEventListener('DOMContentLoaded', function () {

      function asyncLoadRequiredJs() {
        var iwishSrc = "https://cdn.myshopapps.com/iwish/iwishlist_v2.js";

        function loadScript(src, callback) {
          var s = document.createElement('script');
          s.type = 'text/javascript';
          s.src = src;
          if (callback) {
            s.onload = callback;
          }
          var x = document.getElementsByTagName('script')[0];
          x.parentNode.insertBefore(s, x);
        }

        /* Load jQuery first (if not already loaded), then iWish — sequentially to avoid race condition */
        if (!window.jQuery) {
          loadScript("{{- jquery_cdn_url -}}", function() {
            loadScript(iwishSrc);
          });
        } else {
          loadScript(iwishSrc);
        }
      }

      if (window.attachEvent) {
        window.attachEvent('onload', asyncLoadRequiredJs);
      } else {
        window.addEventListener('load', asyncLoadRequiredJs, false);
      }

    });

  </script>

{%- endif -%}

{% comment %} Add to Wishlist {% endcomment %}
{%- if component == 'add-to-wishlist' -%}
  <div class="prd-Wishlist prd-Wishlist-{{ page_type }}">

    {%- if variant == nil -%}
      {%- assign variant = product.selected_or_first_available_variant -%}
    {%- endif -%}

    <button class="prd-Wishlist_Button prd-Wishlist_Button-{{ page_type }} prd-Wishlist_Button-add iWishAddColl iwishcheck js-Wishlist_Button js-Wishlist_Button-add"
      onclick="this.parentElement.classList.add('prd-Wishlist-added'); window.wishlist.addToWishlist(this, this.dataset.variant, '{{- is_collection -}}')"
      data-variant="{{- variant.id -}}"
      data-product="{{- product.id -}}"
      data-product-handle="{{- product.handle -}}"
      data-pTitle="{{- product.title | escape -}}"
      title="{{- 'wishlist.add_to_wishlist' | t -}}"
    >
    {{- 'wishlist.add_to_wishlist' | t -}}
    </button>

    <button class="prd-Wishlist_Button prd-Wishlist_Button-{{ page_type }} prd-Wishlist_Button-remove js-Wishlist_Button js-Wishlist_Button-remove"
      onclick="this.parentElement.classList.remove('prd-Wishlist-added'); window.wishlist.removeFromWishlist(this, this.dataset.variant, false)"
      data-variant="{{- variant.id -}}"
      data-product="{{- product.id -}}"
      title="{{- 'wishlist.remove_from_wishlist' | t -}}"
    >
      {{- 'wishlist.remove_from_wishlist' | t -}}
    </button>

  </div>
{%- endif -%}
