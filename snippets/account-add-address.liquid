<div class="acc-Section_Form acc-Section_Form-address" id="AddAddress" data-address-add>
  <h2 class="acc-Section_Title acc-Section_Title-gapTop acc-Section_Title-desktop fz-25_33">{{ 'customer.addresses.new_address' | t }}</h2>
  {%- form 'customer_address', customer.new_address, class: 'frm-Form' -%}
    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[first_name]" id="AddressFirstNameNew" value="{{ form.first_name }}" placeholder="{{ 'customer.addresses.first_name' | t }}" autocapitalize="words" required />
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[last_name]" id="AddressLastNameNew" value="{{ form.last_name }}" placeholder="{{ 'customer.addresses.last_name' | t }}" autocapitalize="words" required />
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[company]" id="AddressCompanyNew" value="{{ form.company }}" placeholder="{{ 'customer.addresses.company' | t }}" autocapitalize="words" />
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[address1]" id="AddressAddress1New" value="{{ form.address1 }}" placeholder="{{ 'customer.addresses.address1' | t }}" autocapitalize="words" required />
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[address2]" id="AddressAddress2New" value="{{ form.address2 }}" placeholder="{{ 'customer.addresses.address2' | t }}" autocapitalize="words"/>
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[city]" id="AddressCityNew" value="{{ form.city }}" placeholder="{{ 'customer.addresses.city' | t }}" autocapitalize="words" required />
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
      <select class="frm-Form_Select frm-Form_Select-whiteMobile" name="address[country]" id="AddressCountryNew" required data-address-country data-default="{{ form.country }}">
        {{ country_option_tags }}
      </select>
    </div>

    <div class="frm-Form_Field util-Hide" data-address-province-wrapper>
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
      <select class="frm-Form_Select frm-Form_Select-whiteMobile" name="address[province]" id="AddressProvinceNew" data-address-province data-default="{{ form.province }}"></select>
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="text" name="address[zip]" id="AddressZipNew" value="{{ form.zip }}" placeholder="{{ 'customer.addresses.zip' | t }}" autocapitalize="characters" required />
    </div>

    <div class="frm-Form_Field">
      <label class="frm-Form_Label util-ScreenReaderOnly" for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
      <input class="frm-Form_Input frm-Form_Input-whiteMobile" type="tel" name="address[phone]" id="AddressPhoneNew" pattern="[0-9\-]*" value="{{ form.phone }}" placeholder="{{ 'customer.addresses.phone' | t }}" />
    </div>

    <div class="frm-Form_Checkbox frm-Form_Checkbox-circle frm-Form_Checkbox-gapTopBottom">
      <label class="frm-Form_CheckboxLabel">{{ 'customer.addresses.set_default' | t }}
        {{ form.set_as_default_checkbox }}
        <span class="frm-Form_CheckboxInput"></span>
      </label>
    </div>

    <div class="frm-Form_Actions">
      <button class="acc-Address_Button acc-Address_Button-addAddress btn-Button btn-Button-secondary btn-Button-secondaryMobile btn-Button-wide btn-Button-spacy" type="submit" value="{{ 'customer.addresses.add' | t }}">
        {{ 'customer.addresses.add' | t }}
        <span class="frm-Form_ButtonIcon">
          {%- render 'bao-arrow' -%}
        </span>
      </button>
    </div>
  {%- endform -%}
</div>
