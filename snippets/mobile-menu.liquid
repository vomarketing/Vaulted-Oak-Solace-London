{%- liquid
  assign mobile_section = section
  assign mobile_shop_link = nil
  for mobile_navigation_link in linklists[mobile_section.settings.left_navigation].links
    assign mobile_navigation_title = mobile_navigation_link.title | strip | downcase
    if mobile_navigation_title == 'shop'
      assign mobile_shop_link = mobile_navigation_link
      break
    endif
  endfor
-%}
<div id="MobileMenu-{{ mobile_section.id }}" class="hd-MobileMenu" data-mobile-menu data-background="#ffffff" data-foreground="#000000" data-active-color="#000000" hidden>
  <button type="button" class="hd-MobileMenu_Backdrop" data-mobile-menu-close tabindex="-1" aria-label="Close menu"></button>
  <div class="hd-MobileMenu_Panel" data-mobile-menu-panel>
    <div class="hd-MobileMenu_Scroll">
      <nav class="hd-MobileMenu_Navigation" aria-label="Main navigation">
        <button type="button" class="hd-MobileMenu_Back" data-mobile-menu-back hidden>Back</button>
        <p class="hd-MobileMenu_ActiveTitle" data-mobile-menu-title hidden></p>
        <ul class="hd-MobileMenu_Links">
          {%- for link in linklists[mobile_section.settings.left_navigation].links -%}
            {%- if mobile_shop_link != nil and link != mobile_shop_link -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign mobile_mega_block = nil
              assign mobile_menu_title = link.title | strip | downcase
              for block in mobile_section.blocks
                assign mobile_block_title = block.settings.menu_item_title | strip | downcase
                if block.type == 'mega_menu' and mobile_block_title == mobile_menu_title and block.settings.menu_content != blank
                  assign mobile_mega_block = block
                  break
                endif
              endfor
              assign mobile_link_key = link.title | handleize
              assign mobile_view_id = 'MobileMenu-' | append: mobile_section.id | append: '-' | append: mobile_link_key
            -%}
            <li class="hd-MobileMenu_Item{% if link == mobile_shop_link %} mobile-menu__shop{% endif %}">
              {%- if mobile_mega_block -%}
                {%- assign mobile_menu = mobile_mega_block.settings.menu_content -%}
                {%- unless link == mobile_shop_link -%}
                <button type="button" class="hd-MobileMenu_Link" data-mobile-menu-colors data-background="{{ mobile_menu.background_color.value | default: '#ffffff' | escape }}" data-foreground="{{ mobile_menu.text_color.value | default: '#000000' | escape }}" data-active-color="{{ mobile_menu.active_link_color.value | default: mobile_menu.text_color.value | default: '#000000' | escape }}" data-mobile-menu-toggle-submenu aria-controls="{{ mobile_view_id }}" aria-expanded="false">
                  {{ link.title | escape }}
                </button>
                <div id="{{ mobile_view_id }}" class="hd-MobileMenu_Submenu" data-mobile-menu-submenu hidden>
                {%- endunless -%}
                  {%- for group in mobile_menu.groups.value -%}
                    {%- if group.items.value != blank -%}
                      <ul class="hd-MobileMenu_Links hd-MobileMenu_Links-nested">
                        {%- assign mobile_group_index = forloop.index -%}
                        {%- for item in group.items.value -%}
                          {%- assign mobile_item_view_id = mobile_view_id | append: '-group-' | append: mobile_group_index | append: '-item-' | append: forloop.index -%}
                          {%- liquid
                            assign show_mobile_item = false
                            assign mobile_image_orientation = item.image_orientation.value | default: 'portrait'
                            assign mobile_image_size = item.image_size.value | default: 'medium'
                            assign mobile_copy_placement = item.copy_placement.value | default: 'below'
                            assign mobile_copy_alignment = item.copy_alignment.value | default: 'left'
                            assign mobile_copy_spacing = item.copy_spacing.value | default: 'normal'
                            if item.label.value != blank and item.destination_url.value != blank
                              assign show_mobile_item = true
                            endif
                          -%}
                          {%- if show_mobile_item -%}
                            <li class="hd-MobileMenu_Item">
                              {%- if item.enable_detail.value == true -%}
                                <button type="button" class="hd-MobileMenu_Link" data-mobile-menu-colors data-background="{{ item.background_color.value | default: mobile_menu.background_color.value | default: '#ffffff' | escape }}" data-foreground="{{ item.text_color.value | default: mobile_menu.text_color.value | default: '#000000' | escape }}" data-active-color="{{ item.active_link_color.value | default: item.text_color.value | default: mobile_menu.active_link_color.value | default: mobile_menu.text_color.value | default: '#000000' | escape }}" data-mobile-menu-toggle-submenu aria-controls="{{ mobile_item_view_id }}" aria-expanded="false">
                                  {{ item.label.value | escape }}
                                </button>
                                <div id="{{ mobile_item_view_id }}" class="hd-MobileMenu_Submenu hd-MobileMenu_Submenu-detail" data-mobile-menu-submenu data-orientation="{{ mobile_image_orientation | escape }}" data-size="{{ mobile_image_size | escape }}" data-placement="{{ mobile_copy_placement | escape }}" data-alignment="{{ mobile_copy_alignment | escape }}" data-spacing="{{ mobile_copy_spacing | escape }}" hidden>
                                  {%- render 'mega-menu-preview', item: item, item_id: mobile_item_view_id, mobile_menu_preview: true -%}
                                </div>
                              {%- else -%}
                                <a class="hd-MobileMenu_Link" data-mobile-menu-colors data-background="{{ item.background_color.value | default: mobile_menu.background_color.value | default: '#ffffff' | escape }}" data-foreground="{{ item.text_color.value | default: mobile_menu.text_color.value | default: '#000000' | escape }}" data-active-color="{{ item.active_link_color.value | default: item.text_color.value | default: mobile_menu.active_link_color.value | default: mobile_menu.text_color.value | default: '#000000' | escape }}" href="{{ item.destination_url.value | escape }}">{{ item.label.value | escape }}</a>
                              {%- endif -%}
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- endfor -%}
                {%- unless link == mobile_shop_link -%}
                </div>
                {%- endunless -%}
              {%- elsif link.links.size > 0 -%}
                {%- unless link == mobile_shop_link -%}
                <button type="button" class="hd-MobileMenu_Link" data-mobile-menu-toggle-submenu aria-controls="{{ mobile_view_id }}" aria-expanded="false">
                  {{ link.title | escape }}
                </button>
                <div id="{{ mobile_view_id }}" class="hd-MobileMenu_Submenu" data-mobile-menu-submenu hidden>
                {%- endunless -%}
                  {%- if link.url != blank -%}<a class="hd-MobileMenu_ParentLink" href="{{ link.url }}">View all {{ link.title | escape }}</a>{%- endif -%}
                  {%- render 'mobile-menu-link-tree', links: link.links, depth: 0, id_prefix: mobile_view_id -%}
                {%- unless link == mobile_shop_link -%}
                </div>
                {%- endunless -%}
              {%- else -%}
                <a class="hd-MobileMenu_Link" href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}

          {%- for link in linklists[mobile_section.settings.right_navigation].links -%}
            {%- assign mobile_link_key = link.title | handleize -%}
            {%- assign mobile_view_id = 'MobileMenu-' | append: mobile_section.id | append: '-' | append: mobile_link_key -%}
            <li class="hd-MobileMenu_Item">
              {%- if link.links.size > 0 -%}
                <button type="button" class="hd-MobileMenu_Link" data-mobile-menu-toggle-submenu aria-controls="{{ mobile_view_id }}" aria-expanded="false">{{ link.title | escape }}</button>
                <div id="{{ mobile_view_id }}" class="hd-MobileMenu_Submenu" data-mobile-menu-submenu hidden>
                  {%- if link.url != blank -%}<a class="hd-MobileMenu_ParentLink" href="{{ link.url }}">View all {{ link.title | escape }}</a>{%- endif -%}
                  {%- render 'mobile-menu-link-tree', links: link.links, depth: 0, id_prefix: mobile_view_id -%}
                </div>
              {%- else -%}
                <a class="hd-MobileMenu_Link" href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- assign mobile_need_help_menu = linklists[mobile_section.settings.mobile_need_help_menu] -%}
          {%- assign mobile_need_help_links = mobile_need_help_menu.links -%}
          {%- if mobile_need_help_links != blank -%}
            <li class="hd-MobileMenu_Item hd-MobileMenu_Item-help">
              <section class="hd-MobileMenu_Help" aria-labelledby="MobileMenu-{{ mobile_section.id }}-help-title">
                <h2 id="MobileMenu-{{ mobile_section.id }}-help-title" class="hd-MobileMenu_HelpTitle">{{ mobile_need_help_menu.title | escape }}</h2>
                <ul class="hd-MobileMenu_HelpFeatured">
                  {%- for link in mobile_need_help_links limit: 2 -%}
                    {%- liquid
                      assign mobile_help_parts = link.title | replace: 'Arrow_', '' | replace: '<br />', '<br>' | replace: '<br/>', '<br>' | split: '<br>'
                      assign mobile_help_title = mobile_help_parts[0] | strip
                      assign mobile_help_description = mobile_help_parts[1] | strip
                      assign is_contact_modal = false
                      if link.url contains 'mailto:' or link.url contains '#contactUSModal' or link.url contains '#contact-modal' or link.url contains '#contactUsModal'
                        assign is_contact_modal = true
                      endif
                    -%}
                    <li class="hd-MobileMenu_HelpItem">
                      <a
                        class="hd-MobileMenu_HelpLink hd-MobileMenu_HelpLink-featured"
                        href="{{ link.url | escape }}"
                        {% if is_contact_modal %}
                          data-contact-modal-trigger
                          aria-haspopup="dialog"
                          aria-controls="contactUSModal"
                        {% endif %}
                      >
                        <span class="hd-MobileMenu_HelpCopy">
                          <span class="hd-MobileMenu_HelpLabel">{{ mobile_help_title | escape }}</span>
                          {%- if mobile_help_description != blank -%}<span class="hd-MobileMenu_HelpDescription">{{ mobile_help_description | escape }}</span>{%- endif -%}
                        </span>
                        {%- if link.title contains 'Arrow_' -%}
                          <span class="hd-MobileMenu_HelpArrow" aria-hidden="true"></span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if mobile_need_help_links.size > 2 -%}
                  <ul class="hd-MobileMenu_HelpLinks">
                    {%- for link in mobile_need_help_links offset: 2 -%}
                      <li class="hd-MobileMenu_HelpItem">
                        <a class="hd-MobileMenu_HelpLink" href="{{ link.url | escape }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </section>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    </div>
    <div class="hd-MobileMenu_Footer">
      <a href="{{ routes.cart_url }}" data-module-drawers-trigger="cart">Bag (<span data-push-cart-count>{{ cart.item_count }}</span>)</a>
      {%- if settings.wishlist_enable -%}
        <button type="button" data-module-drawers-trigger="cart" data-mini-tab-target="saved">{{ 'wishlist.saved_products' | t }} (<wishlist-count>0</wishlist-count>)</button>
      {%- else -%}
        <span></span>
      {%- endif -%}
    </div>
  </div>
</div>
