{% comment %}
  /*
  |--------------------------------------------------------------------------
  | Video Embed
  |--------------------------------------------------------------------------
  | Parameters:
  | 
  | video_url
  | [Type: string (URL to an uploaded MP4 or full URL)
  |
  | video_poster
  | [Type: image_picker (The image to show before the video plays)]
  | 
  | video_aspect_ratio
  | [Type: select (options: 100% (1:1), 56.25% (16:9), 75% (4:3), 66.66% (3:2), 62.5% (8:5) )]
  | 
  */
{% endcomment %}

{%- if video_url != blank -%}

  {%- assign img_url = video_poster | img_url: '' -%}

  <div class="vid-Embed" style="--Video_AspectRatio:{{ video_aspect_ratio }};">
  
    <video class="vid-Embed_Video video-js" 
      controls 
      preload="none" 
      data-setup="{}"
      {% if video_poster != blank %} poster="{{ img_url }}" {% endif %} 
      {% if video_autoplay == true %} autoplay muted loop {% endif %}>
      <source src="{{ video_url }}" type="video/mp4">
    </video>

  </div>

{%- endif -%}