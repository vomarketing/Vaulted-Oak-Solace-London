{% comment %}
  /*
  |--------------------------------------------------------------------------
  | Video Embed
  |--------------------------------------------------------------------------
  | Parameters:
  | 
  | video_url
  | [Type: string (URL to an uploaded MP4 or full URL)
  |
  | video_poster
  | [Type: image_picker (The image to show before the video plays)]
  | 
  | video_aspect_ratio
  | [Type: select (options: 100% (1:1), 56.25% (16:9), 75% (4:3), 66.66% (3:2), 62.5% (8:5) )]
  | 
  */
{% endcomment %}

{%- if video_url != blank -%}

  {%- assign img_url = video_poster | img_url: '' -%}

  {% comment %}
    Video.js is loaded here, next to its only consumer, rather than in
    layout/theme.liquid, so pages without an embed never request it.
    Several embeds can share a page: the browser fetches a stylesheet URL
    once, and the script is guarded so it is injected once.
  {% endcomment %}
  <link href="https://vjs.zencdn.net/7.10.2/video-js.css" rel="stylesheet">
  <script>
    (function () {
      if (window.__videojsRequested) return;
      window.__videojsRequested = true;

      function loadVideoJs() {
        var script = document.createElement('script');
        script.src = 'https://vjs.zencdn.net/7.10.2/video.min.js';
        document.head.appendChild(script);
      }

      // Video.js auto-setup runs once, right after the library executes, and
      // only initialises the <video data-setup> elements that exist by then.
      // Wait for the full DOM so every embed on the page is picked up.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadVideoJs);
      } else {
        loadVideoJs();
      }
    })();
  </script>

  <div class="vid-Embed" style="--Video_AspectRatio:{{ video_aspect_ratio }};">
  
    <video class="vid-Embed_Video video-js" 
      controls 
      preload="none" 
      data-setup="{}"
      {% if video_poster != blank %} poster="{{ img_url }}" {% endif %} 
      {% if video_autoplay == true %} autoplay muted loop {% endif %}>
      <source src="{{ video_url }}" type="video/mp4">
    </video>

  </div>

{%- endif -%}