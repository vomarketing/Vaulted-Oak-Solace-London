{%- comment -%}Render the Search & Discovery filters available on Search results{%- endcomment -%}
{{ 'collection-filters-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-filter-app.js' | asset_url }}" defer></script>

{%- assign current_sort = search.sort_by | default: search.default_sort_by -%}

<div class="collection-filter-app collection-filter-v2 js-search-filter-app" data-collection-filter-app>
  <form class="collection-filter-v2__form js-search-filter-form" action="{{ routes.search_url }}" method="get" data-collection-filter-app-form data-section-id="{{ section.id }}">
    <input type="hidden" name="q" value="{{ search.terms | escape }}">
    <input type="hidden" name="type" value="product">

    <div class="collection-filter-v2__header">
      <h2 class="collection-filter-v2__title text-med-14 uppercase">{{ 'collections.general.filter_and_sort' | t | default: 'Filter & Sort' }}</h2>
      <button class="collection-filter-v2__close text-med-12 uppercase underline js-search-filter-close" type="button" data-module-drawers-close="search-filters">
        {{ 'collections.general.filter_close' | t | default: 'Close' }}
      </button>
    </div>

    <div class="collection-filter-v2__body">
      <div class="collection-filter-v2__groups">
        {%- for filter in search.filters -%}
          {%- if filter.type == 'list' or filter.type == 'boolean' -%}
            <details class="collection-filter-v2__group" {% if filter.active_values.size > 0 %}open{% endif %}>
              <summary class="collection-filter-v2__summary js-search-filter-summary text-med-12 uppercase">
                <span>{{ filter.label | escape }}</span>
                <span class="collection-filter-v2__toggle" aria-hidden="true"></span>
              </summary>

              <div class="collection-filter-v2__panel">
                <ul class="collection-filter-v2__options">
                  {%- for filter_value in filter.values -%}
                    {%- assign option_id = 'search-filter-app-' | append: section.id | append: '-' | append: filter.param_name | handleize | append: '-' | append: forloop.index -%}
                    <li class="collection-filter-v2__option">
                      <label class="collection-filter-v2__choice text-reg-12 js-search-filter-choice" for="{{ option_id }}">
                        <input
                          class="collection-filter-v2__input js-search-filter-input"
                          id="{{ option_id }}"
                          type="checkbox"
                          name="{{ filter_value.param_name | escape }}"
                          value="{{ filter_value.value | escape }}"
                          {% if filter_value.active %}checked{% endif %}
                        >
                        <span class="collection-filter-v2__indicator" aria-hidden="true"></span>
                        <span class="collection-filter-v2__choice-label">{{ filter_value.label | escape }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.enable_sorting -%}
        <details class="collection-filter-v2__group collection-filter-v2__group--sort" open>
          <summary class="collection-filter-v2__summary js-search-filter-summary text-med-12 uppercase">
            <span>Sort By</span>
            <span class="collection-filter-v2__toggle" aria-hidden="true"></span>
          </summary>
          <div class="collection-filter-v2__panel">
            <ul class="collection-filter-v2__options">
              {%- assign sort_keys = 'relevance,created-descending,price-ascending,price-descending' | split: ',' -%}
              {%- for sort_key in sort_keys -%}
                {%- capture sort_label -%}
                  {%- case sort_key -%}
                    {%- when 'relevance' -%}Relevance
                    {%- when 'created-descending' -%}{{ 'collections.sorting.new_in' | t | default: 'New In' }}
                    {%- when 'price-ascending' -%}{{ 'collections.sorting.ascending_price' | t | default: 'Price Low to High' }}
                    {%- when 'price-descending' -%}{{ 'collections.sorting.descending_price' | t | default: 'Price High to Low' }}
                  {%- endcase -%}
                {%- endcapture -%}
                <li class="collection-filter-v2__option">
                  <label class="collection-filter-v2__choice text-reg-12 js-search-filter-choice" for="search-filter-app-sort-{{ sort_key }}-{{ section.id }}">
                    <input
                      class="collection-filter-v2__input js-search-filter-input"
                      id="search-filter-app-sort-{{ sort_key }}-{{ section.id }}"
                      type="radio"
                      name="sort_by"
                      value="{{ sort_key }}"
                      {% if current_sort == sort_key or current_sort == blank and sort_key == 'relevance' %}checked{% endif %}
                    >
                    <span class="collection-filter-v2__indicator" aria-hidden="true"></span>
                    <span class="collection-filter-v2__choice-label">{{ sort_label | strip }}</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </details>
      {%- elsif search.sort_by != blank -%}
        <input type="hidden" name="sort_by" value="{{ search.sort_by | escape }}">
      {%- endif -%}
    </div>

    <div class="collection-filter-v2__footer">
      <button class="collection-filter-v2__submit text-med-12 uppercase js-search-filter-submit" type="submit" data-collection-filter-app-submit>
        Show <span class="js-search-filter-count" data-collection-filter-app-result-count>{{ search.results_count }}</span> Items
      </button>
    </div>
  </form>
</div>
