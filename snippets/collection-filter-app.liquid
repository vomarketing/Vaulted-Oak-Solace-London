{%- comment -%}
  Render the Search & Discovery filters for a collection or search results.
{%- endcomment -%}
{{ 'collection-filters-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-filter-app.js' | asset_url }}" defer></script>

{%- liquid
  if context == 'search'
    assign filter_source = search
    assign form_action = routes.search_url
    assign drawer_id = 'search-filters'
    assign results_count = search.results_count
    assign sort_keys = 'relevance,price-ascending,price-descending' | split: ','
  else
    assign filter_source = collection
    assign form_action = collection.url
    assign drawer_id = 'clc-filters'
    assign results_count = collection.products_count
    assign sort_keys = 'manual,created-descending,price-ascending,price-descending' | split: ','
  endif

  assign current_sort = filter_source.sort_by | default: filter_source.default_sort_by
  assign id_prefix = context | default: 'collection' | append: '-filter-app-' | append: section.id
-%}

<div class="collection-filter-app collection-filter-v2" data-collection-filter-app>
  <form class="collection-filter-v2__form" action="{{ form_action }}" method="get" data-collection-filter-app-form data-section-id="{{ section.id }}">
    {%- if context == 'search' -%}
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
    {%- endif -%}

    <div class="collection-filter-v2__header">
      <h2 class="collection-filter-v2__title">{{ 'collections.general.filter_and_sort' | t }}</h2>
      <button class="collection-filter-v2__close" type="button" data-module-drawers-close="{{ drawer_id }}">
        {{ 'collections.general.filter_close' | t }}
      </button>
    </div>

    <div class="collection-filter-v2__body">
      <div class="collection-filter-v2__groups">
        {%- for filter in filter_source.filters -%}
          {%- if filter.type == 'list' or filter.type == 'boolean' -%}
            <details class="collection-filter-v2__group" {% if filter.active_values.size > 0 %}open{% endif %}>
              <summary class="collection-filter-v2__summary">
                <span>{{ filter.label | escape }}</span>
                <span class="collection-filter-v2__toggle" aria-hidden="true"></span>
              </summary>

              <div class="collection-filter-v2__panel">
                <ul class="collection-filter-v2__options">
                  {%- for filter_value in filter.values -%}
                    {%- assign option_id = id_prefix | append: '-' | append: filter.param_name | handleize | append: '-' | append: forloop.index -%}
                    <li class="collection-filter-v2__option">
                      <label class="collection-filter-v2__choice" for="{{ option_id }}">
                        <input
                          class="collection-filter-v2__input"
                          id="{{ option_id }}"
                          type="checkbox"
                          name="{{ filter_value.param_name | escape }}"
                          value="{{ filter_value.value | escape }}"
                          {% if filter_value.active %}checked{% endif %}
                        >
                        <span class="collection-filter-v2__indicator" aria-hidden="true"></span>
                        <span class="collection-filter-v2__choice-label">{{ filter_value.label | escape }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.enable_sorting -%}
        <details class="collection-filter-v2__group collection-filter-v2__group--sort" open>
          <summary class="collection-filter-v2__summary">
            <span>Sort By</span>
            <span class="collection-filter-v2__toggle" aria-hidden="true"></span>
          </summary>
          <div class="collection-filter-v2__panel">
            <ul class="collection-filter-v2__options">
              {%- for sort_key in sort_keys -%}
                {%- capture sort_label -%}
                  {%- case sort_key -%}
                    {%- when 'manual' -%}{{ 'collections.sorting.featured' | t }}
                    {%- when 'relevance' -%}{{ 'collections.sorting.relevance' | t }}
                    {%- when 'created-descending' -%}{{ 'collections.sorting.new_in' | t }}
                    {%- when 'price-ascending' -%}{{ 'collections.sorting.ascending_price' | t }}
                    {%- when 'price-descending' -%}{{ 'collections.sorting.descending_price' | t }}
                  {%- endcase -%}
                {%- endcapture -%}
                <li class="collection-filter-v2__option">
                  <label class="collection-filter-v2__choice" for="{{ id_prefix }}-sort-{{ sort_key }}">
                    <input class="collection-filter-v2__input" id="{{ id_prefix }}-sort-{{ sort_key }}" type="radio" name="sort_by" value="{{ sort_key }}" {% if current_sort == sort_key %}checked{% endif %}>
                    <span class="collection-filter-v2__indicator" aria-hidden="true"></span>
                    <span class="collection-filter-v2__choice-label">{{ sort_label | strip }}</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </details>
      {%- elsif filter_source.sort_by != blank -%}
        <input type="hidden" name="sort_by" value="{{ filter_source.sort_by | escape }}">
      {%- endif -%}
    </div>

    <div class="collection-filter-v2__footer">
      <button class="collection-filter-v2__clear" type="button" data-collection-filter-clear>Clear all</button>
      <button class="collection-filter-v2__submit" type="submit" data-collection-filter-app-submit>
        Show <span data-collection-filter-app-result-count>{{ results_count }}</span> Items
      </button>
    </div>
  </form>
</div>
