{%- liquid
  assign compare_total = item.variant.compare_at_price | times: item.quantity
  assign was_price = item.original_line_price
  if item.variant.compare_at_price > item.variant.price and compare_total > was_price
    assign was_price = compare_total
  endif
-%}
<article class="mbg-Item" data-mini-item data-key="{{ item.key | escape }}" data-quantity="{{ item.quantity }}">
  <a class="mbg-Image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
    {% if item.image %}{{ item.image | image_url: width: 260 | image_tag: widths: '90, 130, 180, 260', sizes: '(max-width: 767px) 80px, 96px', loading: 'lazy' }}{% endif %}
  </a>
  <div class="mbg-Details">
    <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
    {% unless item.product.has_only_default_variant %}
      {% for option in item.options_with_values %}<p>{{ option.name | escape }}: {{ option.value | escape }}</p>{% endfor %}
    {% endunless %}
    {% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
    {% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}
    {% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }}</p>{% endfor %}
  </div>
  <div class="mbg-Price">{% if was_price > item.final_line_price %}<s>{{ was_price | money }}</s>{% endif %}<span{% if was_price > item.final_line_price %} class="mbg-SalePrice"{% endif %}>{{ item.final_line_price | money }}</span></div>
  <div class="mbg-Quantity" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
    <button type="button" data-mini-step="-1" aria-label="Decrease quantity"{% if item.quantity <= 1 %} disabled{% endif %}>−</button>
    <span aria-label="Quantity {{ item.quantity }}">{{ item.quantity }}</span>
    <button type="button" data-mini-step="1" aria-label="Increase quantity">+</button>
  </div>
  <div class="mbg-Remove-Wishlist">
    <button class="mbg-Remove" type="button" data-mini-remove aria-label="Remove {{ item.product.title | escape }}">Remove</button>
    <button class="bag-Item_Wishlist" type="button" aria-label="{{ 'wishlist.add_to_wishlist' | t }}">
      {%- render 'icons', icon: 'bookmark' -%}
    </button>
  </div>
</article>
