<form class="bis-Form" data-module="back-in-stock" onsubmit="event.preventDefault()">

  <div class="bis-Form_Body">

    <input
      class="bis-Form_Input frm-Form_Input frm-Form_Input-allowInvert"
      data-el="back-in-stock.email"
      type="email"
      placeholder="{{ settings.bis_placeholder }}"
      value=""
    >

    <button class="bis-Form_Button frm-Form_Button" 
      type="button"
      data-el="back-in-stock.trigger"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-product-id="{{ product.id }}"
    >
    
      <span class="frm-Form_ButtonText">
        {{ settings.bis_button_text }}
      </span>

      <span class="frm-Form_ButtonIcon">
        {%- render 'bao-arrow' -%}
      </span>

    </button>

  </div>

  <div class="bis-Form_Footer">

    <div class="bis-Form_Response rte-RichText"
      aria-hidden="true"
      data-el="back-in-stock.response"
      data-error="{{ settings.bis_error_message }}"
      data-success="{{ settings.bis_success_message }}">
    </div>

  </div>

</form>
