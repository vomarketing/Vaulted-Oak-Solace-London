{%- doc -%}
  Renders the fullscreen product media zoom modal for PDP (New).
  @param {product} product - Product Liquid object
{%- enddoc -%}

{%- liquid
  assign default_header_mode = section.settings.header_contrast_mode | default: 'light'

  assign move_first_to_last = false
  if product.media.size > 1
    for tag in product.tags
      assign downcased_tag = tag | downcase
      if downcased_tag == 'first-image-last' or downcased_tag == 'first_image_last'
        assign move_first_to_last = true
        break
      endif
    endfor
  endif
-%}

<div
  class="pdp-zoom-modal js-pdp-zoom-modal"
  id="pdp-zoom-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Fullscreen Product Media Zoom"
  aria-hidden="true"
  data-header-mode="{{ default_header_mode }}"
>
  <button
    type="button"
    class="pdp-zoom-modal__close js-pdp-zoom-close text-med-14"
    aria-label="Close fullscreen zoom"
  >
    Close
  </button>

  <div class="pdp-zoom-modal__container js-pdp-zoom-container">
    {%- if move_first_to_last -%}
      {%- for media in product.media offset: 1 -%}
        {%- liquid
          assign visual_index = forloop.index0
          assign header_mode = default_header_mode
          assign alt_lower = media.alt | downcase
          if alt_lower contains 'header:dark'
            assign header_mode = 'dark'
          elsif alt_lower contains 'header:light'
            assign header_mode = 'light'
          endif
        -%}
        <div
          class="pdp-zoom-modal__item js-pdp-zoom-item"
          id="pdp-zoom-item-{{ visual_index }}"
          data-zoom-index="{{ visual_index }}"
          data-header-mode="{{ header_mode }}"
        >
          {%- if media.media_type == 'image' -%}
            {%- render 'picture',
              image_desktop: media,
              class: 'pdp-zoom-modal__img',
              picture_class: 'pdp-zoom-modal__picture',
              loading: 'lazy',
              alt: media.alt,
              widths: '375, 550, 750, 900, 1100, 1200, 1500, 1800, 2000, 2400',
              sizes: '100vw'
            -%}
          {%- elsif media.media_type == 'video' -%}
            <div class="pdp-zoom-modal__video-wrapper" style="aspect-ratio: {{ media.aspect_ratio | default: 0.75 }};">
              <video
                class="pdp-zoom-modal__video js-pdp-zoom-video"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
              >
                {%- for source in media.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- liquid
        assign media = product.media.first
        assign visual_index = product.media.size | minus: 1
        assign header_mode = default_header_mode
        assign alt_lower = media.alt | downcase
        if alt_lower contains 'header:dark'
          assign header_mode = 'dark'
        elsif alt_lower contains 'header:light'
          assign header_mode = 'light'
        endif
      -%}
      <div
        class="pdp-zoom-modal__item js-pdp-zoom-item"
        id="pdp-zoom-item-{{ visual_index }}"
        data-zoom-index="{{ visual_index }}"
        data-header-mode="{{ header_mode }}"
      >
        {%- if media.media_type == 'image' -%}
          {%- render 'picture',
            image_desktop: media,
            class: 'pdp-zoom-modal__img',
            picture_class: 'pdp-zoom-modal__picture',
            loading: 'lazy',
            alt: media.alt,
            widths: '375, 550, 750, 900, 1100, 1200, 1500, 1800, 2000, 2400',
            sizes: '100vw'
          -%}
        {%- elsif media.media_type == 'video' -%}
          <div class="pdp-zoom-modal__video-wrapper" style="aspect-ratio: {{ media.aspect_ratio | default: 0.75 }};">
            <video
              class="pdp-zoom-modal__video js-pdp-zoom-video"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
            >
              {%- for source in media.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          </div>
        {%- endif -%}
      </div>

    {%- else -%}
      {%- for media in product.media -%}
        {%- liquid
          assign header_mode = default_header_mode
          assign alt_lower = media.alt | downcase
          if alt_lower contains 'header:dark'
            assign header_mode = 'dark'
          elsif alt_lower contains 'header:light'
            assign header_mode = 'light'
          endif
        -%}
        <div
          class="pdp-zoom-modal__item js-pdp-zoom-item"
          id="pdp-zoom-item-{{ forloop.index0 }}"
          data-zoom-index="{{ forloop.index0 }}"
          data-header-mode="{{ header_mode }}"
        >
          {%- if media.media_type == 'image' -%}
            {%- render 'picture',
              image_desktop: media,
              class: 'pdp-zoom-modal__img',
              picture_class: 'pdp-zoom-modal__picture',
              loading: 'lazy',
              alt: media.alt,
              widths: '375, 550, 750, 900, 1100, 1200, 1500, 1800, 2000, 2400',
              sizes: '100vw'
            -%}
          {%- elsif media.media_type == 'video' -%}
            <div class="pdp-zoom-modal__video-wrapper" style="aspect-ratio: {{ media.aspect_ratio | default: 0.75 }};">
              <video
                class="pdp-zoom-modal__video js-pdp-zoom-video"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
              >
                {%- for source in media.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
