{%- doc -%}
  Footer newsletter signup form, submitted to a Klaviyo list via the Client Subscriptions API (custom-footer.js).

  @param {string} form_id - Unique id for the form element
  @param {string} placeholder - Email input placeholder
  @param {string} klaviyo_company_id - Klaviyo public API key (site ID)
  @param {string} klaviyo_list_id - Klaviyo list the profile is subscribed to
  @param {string} source - Value saved as the subscription's custom_source
  @param {string} [disclaimer] - Richtext rendered under the field
{%- enddoc -%}

<form
  id="{{ form_id }}"
  class="ft-Newsletter_Form"
  action="#"
  data-footer-newsletter-form
  data-klaviyo-company-id="{{ klaviyo_company_id | escape }}"
  data-klaviyo-list-id="{{ klaviyo_list_id | escape }}"
  data-klaviyo-source="{{ source | escape }}"
  data-country="{{ localization.country.iso_code }}"
>
  <div class="ft-Newsletter_Bottom">
    <div class="ft-Newsletter_Field">
      <label class="util-ScreenReaderOnly" for="{{ form_id }}-email">{{ 'layout.footer.newsletter_email' | t }}</label>
      <input
        class="ft-Newsletter_Input"
        id="{{ form_id }}-email"
        type="email"
        name="email"
        placeholder="{{ placeholder }}"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
      >
      <button class="ft-Newsletter_Submit" type="submit">{{ 'layout.footer.newsletter_submit' | t }}</button>
    </div>

    <p
      class="ft-Newsletter_Status"
      role="status"
      aria-live="polite"
      data-footer-newsletter-status
      data-success-message="{{ 'layout.footer.newsletter_success' | t | escape }}"
      data-error-message="{{ 'layout.footer.newsletter_error' | t | escape }}"
    ></p>

    {%- if disclaimer != blank -%}
      <div class="ft-Newsletter_Disclaimer">{{ disclaimer }}</div>
    {%- endif -%}
  </div>
</form>
