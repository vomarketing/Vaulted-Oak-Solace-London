{%- liquid
  assign title = help.help_title | default: 'Help'
  assign contact_url = help.help_contact_link
  if contact_url == blank and help.help_contact_email != blank
    assign contact_url = 'mailto:' | append: help.help_contact_email
  endif
  if help.help_contact_modal and contact_url == blank
    assign contact_url = '#contactUSModal'
  endif
-%}

<style>
  {{ 'help-box.css' | inline_asset_content }}
</style>
<script src="{{ 'help-box.js' | asset_url }}" defer="defer"></script>

<help-box>
  {%- if help.help_contact_enable -%}
    <button
      type="button"
      class="hb-HelpBox_Launcher"
      data-help-box-open
      aria-controls="HelpBox"
      aria-expanded="false"
      aria-haspopup="dialog"
    >
      {{ help.help_mobile_label | default: 'Contact Us' }}
    </button>
  {%- endif -%}

  <div
    class="hb-HelpBox"
    id="HelpBox"
    aria-hidden="true"
    hidden
  >
    <button
      class="hb-HelpBox_Overlay"
      type="button"
      data-help-box-close
      aria-label="Close contact"
      tabindex="-1"
    ></button>

    <section
      class="hb-HelpBox_Dialog"
      role="dialog"
      aria-modal="false"
      aria-labelledby="HelpBoxTitle"
      tabindex="-1"
    >
      <header class="hb-HelpBox_Header">
        <h2 class="hb-HelpBox_Title" id="HelpBoxTitle">{{ title }}</h2>
        <button class="hb-HelpBox_Close" type="button" data-help-box-close>Close</button>
      </header>

      <div class="hb-HelpBox_Body">
        {%- if contact_url != blank and help.help_contact_enable -%}
          <a
            class="hb-HelpBox_Email"
            href="{{ contact_url }}"
            {% if help.help_contact_modal %}
              data-contact-modal-trigger
              aria-haspopup="dialog"
              aria-controls="contactUSModal"
            {% endif %}
          >
            <span class="hb-HelpBox_EmailText">
              {{ help.help_contact_label }}
              {%- if help.help_contact_email != blank -%}
                <br>{{ help.help_contact_email }}
              {%- endif -%}
            </span>
            <span class="hb-HelpBox_Chevron" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8.93 8 5.78 4.85l.62-.62L10.17 8l-3.77 3.77-.62-.62L8.93 8Z" fill="currentColor"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- if help.help_menu != blank and linklists[help.help_menu].links.size > 0 -%}
          <nav class="hb-HelpBox_Links" aria-label="{{ title | escape }}">
            {%- for link in linklists[help.help_menu].links -%}
              <a class="hb-HelpBox_Link" href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </section>
  </div>
</help-box>
