{%- liquid
  assign category_filter_key = blank
  assign category_tags_string = blank
  assign active_category_tag = blank
  assign retained_tag_handles = blank

  for block in section.blocks
    assign block_filter_key = block.settings.filter_key | strip | downcase
    if block_filter_key == 'category'
      assign category_filter_key = 'filter-' | append: block_filter_key | append: ': '
      break
    endif
  endfor

  if category_filter_key != blank
    for collection_tag in collection.all_tags
      if collection_tag contains category_filter_key
        assign category_tags_string = category_tags_string | append: ',' | append: collection_tag
      endif
    endfor

    for current_tag in current_tags
      if current_tag contains category_filter_key
        assign active_category_tag = current_tag
      else
        assign current_tag_handle = current_tag | handleize
        if current_tag_handle contains '-amp-'
          assign current_tag_handle = current_tag_handle | replace: '-amp-', '-'
        endif
        assign retained_tag_handles = retained_tag_handles | append: '+' | append: current_tag_handle
      endif
    endfor
  endif

  assign category_tags_string = category_tags_string | remove_first: ','
  assign category_tags = category_tags_string | split: ','
  assign retained_tag_handles = retained_tag_handles | remove_first: '+'
  assign all_categories_url = collection.url
  if retained_tag_handles != blank
    assign all_categories_url = all_categories_url | append: '/' | append: retained_tag_handles
  endif
-%}

<div class="collection-header__navigation">
  <h1 class="collection-header__title">
    {%- if category_tags_string != blank -%}
      <a
        class="collection-header__title-link"
        href="{{ all_categories_url }}"
        {% if active_category_tag == blank %}aria-current="page"{% endif %}
      >
        {{ collection.title }}
        ({{ collection.products_count }})
      </a>
    {%- else -%}
      {{ collection.title }}
      ({{ collection.products_count }})
    {%- endif -%}
  </h1>

  {%- if category_tags_string != blank -%}
    <nav class="collection-subcategories" aria-label="By category">
      <ul class="collection-subcategories__list">
        {%- for category_tag in category_tags -%}
          {%- liquid
            assign category_tag_handle = category_tag | handleize
            if category_tag_handle contains '-amp-'
              assign category_tag_handle = category_tag_handle | replace: '-amp-', '-'
            endif

            assign category_path = retained_tag_handles
            if category_path != blank
              assign category_path = category_path | append: '+'
            endif
            assign category_path = category_path | append: category_tag_handle
            assign category_label = category_tag | remove: category_filter_key | split: '|' | last
          -%}

          <li class="collection-subcategories__item">
            <a
              class="collection-subcategories__link"
              href="{{ collection.url }}/{{ category_path }}"
              {% if active_category_tag == category_tag %}aria-current="page"{% endif %}
            >
              {{ category_label }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</div>
