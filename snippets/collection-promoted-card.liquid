{%- liquid
  assign promoted_image = collection.metafields.custom.promoted_image.value
  assign promoted_mobile_image = collection.metafields.custom.promoted_mobile_image.value | default: promoted_image
  assign promoted_text = collection.metafields.custom.promoted_text
  assign promoted_is_product = collection.metafields.custom.promoted_is_a_product.value
  assign promoted_product = collection.metafields.custom.promoted_product.value
  assign promoted_url = collection.metafields.custom.promoted_url.value
  assign promoted_link = blank

  if promoted_is_product
    if promoted_product != blank
      assign promoted_link = promoted_product.url
    endif
  elsif promoted_url != blank
    assign promoted_link = promoted_url
  endif
-%}
<div class="clc-PromotedCard js-Animate" data-animation="Fade">
  {%- if promoted_link != blank -%}
    <a class="clc-PromotedCard_Link" href="{{ promoted_link | escape }}">
  {%- else -%}
    <div class="clc-PromotedCard_Link">
  {%- endif -%}

  <div class="clc-PromotedCard_ImageContainer">
    <div class="clc-PromotedCard_Image clc-PromotedCard_Image-desktop">
      {%- render 'responsive-image',
        image: promoted_image,
        width: 3250,
        height: 2380
      -%}
    </div>

    {%- if promoted_mobile_image != blank -%}
      <div class="clc-PromotedCard_Image clc-PromotedCard_Image-mobile">
        {%- render 'responsive-image',
          image: promoted_mobile_image,
          width: 824,
          height: 1161
        -%}
      </div>
    {%- endif -%}
  </div>

  <div class="clc-PromotedCard_Content fz-12_12">
    {%- if promoted_is_product and promoted_product != blank -%}
      <h3 class="clc-PromotedCard_Title fz-12_12">{{ promoted_product.title }}</h3>

      <div class="clc-PromotedCard_Price">
        {%- render 'product-price', product: promoted_product %}
      </div>
    {%- elsif promoted_text != blank -%}
      <div class="clc-PromotedCard_Text rte-RichText">
        {{ promoted_text | metafield_tag }}
      </div>
    {%- endif -%}
  </div>

  {%- if promoted_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>
