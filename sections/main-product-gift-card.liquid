{%- render 'section-product' with product, section -%}

{%- if product.metafields.Detail.Recommended_Products != blank -%}
  <section class="sec-Section sec-Section-flushUntilMd">
    <div class="sec-Section_Inner lyt-Container">
      <header class="sec-Section_Header">
        {%- capture recommended_title -%}
          {%- if product.metafields.Detail.Recommended_Title -%}
            {{ product.metafields.Detail.Recommended_Title }}
          {%- else -%}
            {{ 'products.product.recommended_products' | t }}
          {%- endif -%}
        {%- endcapture -%}

        <h2 class="sec-Section_Title fz-12_12">{{ recommended_title }}</h2>
      </header>

      <div class="sec-Section_Body">
        <div
          class="prd-Recommended css-Scroller"
          data-module="css-scroller" 
          data-css-scroller-remove-at-breakpoint="md"
        >
          <div class="prd-Recommended_Items css-Scroller_Items" data-el="css-scroller.track">
            {%- assign recommended_handles = product.metafields.Detail.Recommended_Products | split: '|' -%}

            <div class="prd-Recommended_Item css-Scroller_Spacer"></div>

            {%- for recommended_handle in recommended_handles -%}
              {%- assign recommended_product = all_products[recommended_handle] -%}

              {%- if recommended_product != blank -%}
                <div
                  class="prd-Recommended_Item css-Scroller_Item js-Animate"
                  data-animation="Fade"
                  {% if forloop.last %} style="--Item_HorizontalSpacing: 0;"{% endif %}
                >
                  {%- render 'product-card', product: recommended_product -%}
                </div>
              {%- endif -%}
            {%- endfor -%}

            <div class="prd-Recommended_Item css-Scroller_Spacer"></div>
          </div>

          <div
            class="prd-Recommended_Scroller css-Scroller_Scroller"
            data-el="css-scroller.scroller"
          >
            <div
              class="prd-Recommended_Thumb css-Scroller_Thumb"
              data-el="css-scroller.thumb"
            ></div>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{%- if collection -%}
  <div class="pg-Back">
    <div class="pg-Back_Inner lyt-Container">
      <div class="pg-Back_Body">
        <a class="pg-Back_Link" href="{{ collection.url }}">
          <span class="pg-Back_Icon">{%- render 'bao-chevron-left' -%}</span>

          <span class="pg-Back_Text">{{ 'products.product.back' | t }}</span>
        </a>
      </div>
    </div>
  </div>
{%- endif -%}

{%- render 'structured-data-product', product: product -%}

<script type="text/javascript">
if (typeof(BIS) !== 'undefined') {
  if (BIS.urlIsProductPage()) {
    BISPopover.ready.then(function() {
      var link;
      var root = $('.module.unavailable');
      if (root[0]) {
        link = $('<span>', {
          text: BISConfig.labels.button_label,
          type: 'button',
          class: 'action-button',
          id: 'BIS_trigger',
          css: { display: 'none' }
        });
        root.eq(0).append(link);
      } else {
        link = $('<input>', {
          value: BISConfig.labels.button_label,
          type: 'button',
          class: 'action-button',
          id: 'BIS_trigger',
          css: { display: 'none' }
        });
        $('.submit-wrapper').eq(0).append(link);
      }

      var variant_id;
      var reload = function() {
        try {
          var variant = BIS.detectVariant(BIS.popup);
          if (variant && BIS.popup.variantIsUnavailable(variant)) {
            variant_id = variant.id;
            link.show();
          } else {
            link.hide();
          }
        } catch (e) {};
      };

      link.click(function() {
        BISPopover.form.selectVariant(variant_id);
      });

      setTimeout(reload, 13);

      // sold out products don't have that element
      var elm = $('.single-option-selector')
      if (elm[0]) {
        elm.on('change', reload);

        // prepend event since this theme swallows it
        event = $._data(elm[0], 'events').change.pop()
        $._data(elm[0], 'events').change.unshift(event);
      } else {
        link.show();
      }
    });
  }
}
</script>


{% schema %}
{
  "name": "Main product gift card",
  "settings": []
}
{% endschema %}

