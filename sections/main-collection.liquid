{{ 'main-collection.css' | asset_url | stylesheet_tag }}
{{ 'collection-pagination.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign pagination_amount = 15
  assign has_promoted_item = false
  assign promoted_item_index = null
  assign is_theme_preview = false
  assign selected_size = blank
  assign promoted_item_index_value = collection.metafields.custom.promoted_index.value
  assign promoted_image = collection.metafields.custom.promoted_image.value

  if promoted_item_index_value != blank and promoted_image != blank
    assign promoted_item_index = promoted_item_index_value | plus: 0

    if promoted_item_index > 0 and promoted_item_index <= 15
      assign has_promoted_item = true
      assign pagination_amount = 14
    endif
  endif

  for current_tag in current_tags
    assign current_filter_key = current_tag | split: ':' | first | handleize
    if current_filter_key == 'filter-size'
      assign selected_size = current_tag | split: ':' | last | strip
      break
    endif
  endfor
-%}

{%- capture content_for_header_string -%}{{ content_for_header }}{%- endcapture -%}
{%- if content_for_header_string contains 'previewBarInjector' -%}
  {%- assign is_theme_preview = true -%}
{%- endif -%}

{%- render 'collection-header', collection: collection, section: section, current_tags: current_tags -%}

{%- paginate collection.products by pagination_amount -%}
  <section class="clc-List">
    <div class="clc-List_Inner lyt-Container">
      {%- render 'collection-product-list',
        products: collection.products,
        collection: collection,
        section: section,
        selected_size: selected_size,
        is_theme_preview: is_theme_preview,
        has_promoted_item: has_promoted_item,
        promoted_item_index: promoted_item_index
      -%}
      {%- render 'collection-pagination', paginate: paginate -%}
    </div>

    <div
      class="drw-Drawer drw-Drawer-fromRight"
      data-module-drawers-drawer="clc-filters"
      data-module-drawers-move-me="root"
    >
      <div class="drw-Drawer_Inner">
        <div class="drw-Drawer_Body">
          {%- if section.settings.use_search_and_discovery_filters -%}
            {%- render 'collection-filter-app', collection: collection, section: section, current_tags: current_tags -%}
          {%- else -%}
            {%- render 'collection-filters-v2', collection: collection, section: section, current_tags: current_tags -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_search_and_discovery_filters",
      "label": "Use Search & Discovery filters",
      "info": "Integration is pending. The app snippet currently falls back to the existing filter UI.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sort by filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_first_image_last_tag",
      "label": "Always show 1st image (Ignore tags)",
      "info": "When enabled, all products in this collection will display their 1st image (featured image / flatlay), ignoring any 'first_image_last' product tags.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "set_first_image_as_hover",
      "label": "Set 1st image as hover",
      "info": "When enabled, products with 'first_image_last' tags will display their 1st image on hover.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Filter By",
          "info": "e.g. By Type"
        },
        {
          "type": "text",
          "id": "filter_all_text",
          "label": "Filter All Text",
          "info": "e.g. All Types"
        },
        {
          "type": "text",
          "id": "filter_key",
          "label": "Filter Key",
          "info": "This is the part that will appear where the \"filter-{key}: {label}\" key part is. e.g. type"
        }
      ]
    }
  ]
}
{% endschema %}
