{{ 'main-collection.css' | asset_url | stylesheet_tag }}
{{ 'collection-pagination.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pagination_amount = 15
  assign has_promoted_item = false
  assign promoted_item_index = null
  assign is_theme_preview = false
  assign selected_size = blank

  if collection.metafields.Promoted.Index != blank and collection.metafields.Promoted.Image != blank
    assign has_promoted_item = true
    assign promoted_item_index = collection.metafields.Promoted.Index | plus: 0

    if promoted_item_index > 0 and promoted_item_index <= 15
      assign pagination_amount = 14
    endif
  endif

  for current_tag in current_tags
    assign current_filter_key = current_tag | split: ':' | first | handleize
    if current_filter_key == 'filter-size'
      assign selected_size = current_tag | split: ':' | last | strip
      break
    endif
  endfor
-%}

{%- capture content_for_header_string -%}{{ content_for_header }}{%- endcapture -%}
{%- if content_for_header_string contains 'previewBarInjector' -%}
  {%- assign is_theme_preview = true -%}
{%- endif -%}

{%- render 'collection-header', collection: collection, section: section -%}

{%- paginate collection.products by pagination_amount -%}
  <section class="clc-List">
    <div class="clc-List_Inner lyt-Container">
      <div class="clc-List_Body">
        <div class="prd-List">
          <div class="prd-List_Items">
            {%- for product in collection.products -%}
              {%- liquid
                assign show_product = true
                assign is_nlos_product = false

                if product.tags contains 'NLOS'
                  assign is_nlos_product = true
                  unless is_theme_preview
                    assign show_product = false
                  endunless
                endif

                if selected_size != blank
                  for variant in product.variants
                    if variant.title == selected_size
                      unless variant.available
                        assign show_product = false
                      endunless
                      break
                    endif
                  endfor
                endif
              -%}

              {%- if show_product -%}
                {%- if has_promoted_item and forloop.index == promoted_item_index -%}
                  <div class="prd-List_Item prd-List_Item-span prd-List_Item-promoted">
                    {%- render 'collection-promoted-card', metafields: collection.metafields.Promoted -%}
                  </div>
                {%- endif -%}

                <div class="prd-List_Item{% if is_nlos_product %} NLOS{% endif %} js-Animate" data-animation="Fade">
                  {%- render 'product-card',
                    product: product,
                    check_first_image_tag: section.settings.enable_first_image_last_tag,
                    first_image_as_hover: section.settings.set_first_image_as_hover
                  -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
      {%- render 'collection-pagination', paginate: paginate -%}
    </div>

    <div
      class="drw-Drawer drw-Drawer-fromRight"
      data-module-drawers-drawer="clc-filters"
      data-module-drawers-move-me="root"
    >
      <button
        class="clc-Filters_Link clc-Filters_Link-drawer fz-10_10"
        type="button"
        data-module-drawers-close="clc-filters"
      >
        {{ 'collections.general.filter_close' | t }}

        <div class="clc-Filters_Icon">
          {%- render 'bao-chevron-right' -%}
        </div>
      </button>

      <div class="drw-Drawer_Inner">
        <header class="drw-Drawer_Header">
          <h2 class="drw-Drawer_Title fz-25_33">{{ 'collections.general.filter_title' | t }}</h2>
        </header>

        <div class="drw-Drawer_Body">
          {%- render 'collection-filters' -%}
        </div>
      </div>
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sort by filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_first_image_last_tag",
      "label": "Always show 1st image (Ignore tags)",
      "info": "When enabled, all products in this collection will display their 1st image (featured image / flatlay), ignoring any 'first_image_last' product tags.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "set_first_image_as_hover",
      "label": "Set 1st image as hover",
      "info": "When enabled, products with 'first_image_last' tags will display their 1st image on hover.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Filter By",
          "info": "e.g. By Type"
        },
        {
          "type": "text",
          "id": "filter_all_text",
          "label": "Filter All Text",
          "info": "e.g. All Types"
        },
        {
          "type": "text",
          "id": "filter_key",
          "label": "Filter Key",
          "info": "This is the part that will appear where the \"filter-{key}: {label}\" key part is. e.g. type"
        }
      ]
    }
  ]
}
{% endschema %}
