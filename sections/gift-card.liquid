<div class="prd-GiftCard">
  <div class="prd-GiftCard_Column prd-GiftCard_Column-content">
    <div class="prd-GiftCard_Content">
      <div class="prd-GiftCard_Header">
        <h1 class="prd-GiftCard_Title fz-25_33">
          {{ product.title }}
        </h1>
        <div class="prd-GiftCard_PriceRange">
          {{ product.variants.first.price | money_without_trailing_zeros }} - {{ product.variants.last.price | money_without_trailing_zeros }}
        </div>
        <div class="prd-GiftCard_Text fz-13_18">
          {{ section.settings.description_left }}
        </div>

        {%- unless product.has_only_default_variant -%}
          <div class="prd-GiftCard_Section">
            <div class="prd-GiftCard_Variants">
              {%- for variant in product.variants -%}
                <div class="prd-GiftCard_Variant" data-index="option1" data-value="{{ variant.option1 }}">
                  <h4 class="prd-GiftCard_VariantValue fz-14_18 {% if current_variant.option1 == variant.option1 %} prd-GiftCard_VariantValue-active{% endif %}">{{ variant.option1 | replace: '.00', '' }}</h4>
                </div>
              {%- endfor -%}
            </div>
            <input type="hidden" value="{{ current_variant.option1 }}" data-option data-index="option1">
          </div>
        {%- endunless -%}
      </div>

      <div class="prd-GiftCard_Footer">
        <button
          class="btn-Primary prd-GiftCard_Submit fz-12_12"
          type="submit"
          name="add"
          >

          {{ 'products.product.add_to_bag' | t }}

        </button>

        <div class="prd-GiftCard_Text">
          {{ section.settings.footer_text }}
        </div>
      </div>

    </div>
  </div>
  <div class="prd-GiftCard_Column prd-GiftCard_Column-image">
    <div class="prd-GiftCard_Container">
      <div class="prd-GiftCard_ImageContainer">
        <div class="prd-GiftCard_Image-desktop">
          {%- render 'responsive-image',
            image: section.settings.image_desktop,
            width: 900,
            height: 544 -%}
        </div>

        <div class="prd-GiftCard_Image-mobile">
          {%- render 'responsive-image',
            image: section.settings.image_mobile,
            width: 450,
            height: 277 -%}
        </div>
      </div>

      <h1 class="prd-GiftCard_Title fz-25_33">
        {{ section.settings.title_right }}
      </h1>

      <div class="prd-GiftCard_Text">
        {{ section.settings.description_right }}
      </div>
    </div>
  </div>
</div>

{%- schema -%}
  {
    "name": "Gift card",
    "settings": [
      {
        "type": "text",
        "id": "description_left",
        "label": "Description Left Column"
      },
      {
        "type": "text",
        "id": "footer_text",
        "label": "Footer Text"
      },
      {
        "type": "image_picker",
        "id": "image_desktop",
        "label": "Desktop Image of Gift Card"
      },
      {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image of Gift Card"
      },
      {
      "type": "text",
      "id": "title_right",
      "label": "Title Right Column"
      },
      {
        "type": "text",
        "id": "description_right",
        "label": "Description Right Column"
      }
    ]
  }
{%- endschema -%}
