{%- layout 'password' -%}

<div
  class="pas-Password"
  data-module="password"
  data-password-active-class="pas-Admin-active"
>
  {%- if settings.password_image != blank -%}
    <div
      class="pas-Password_Image lazyload"
      data-bgset="{% render 'responsive-bg-image', image: settings.password_image %}"
    ></div>
  {%- endif -%}

  <div class="pas-Password_Admin">
    <div
      class="pas-Password_Button"
      data-el="password.adminButton"
    >
      {%- render 'bao-icon-admin' -%}
    </div>
  </div>

  <div class="pas-Password_Inner">
    <div class="pas-Password_ImageContainer">
      <div class="pas-Password_BackgroundImage pas-Password_BackgroundImage-mobile">
        {%- render 'responsive-image' with
          image: section.settings.mobile_image,
          width: 375,
          height: 815 -%}
      </div>

      <div class="pas-Password_BackgroundImage pas-Password_BackgroundImage-tablet">
        {%- render 'responsive-image' with
          image: section.settings.desktop_image,
          width: 1366,
          height: 1024 -%}
      </div>

      <div class="pas-Password_BackgroundImage pas-Password_BackgroundImage-desktop">
        {%- render 'responsive-image' with
          image: section.settings.desktop_image,
          width: 1440,
          height: 900 -%}
      </div>
    </div>

    <div class="pas-Newsletter">
      <div class="pas-Newsletter_Inner">
        <div class="pas-Newsletter_Header">
          <div class="pas-Newsletter_Logo" itemscope
               itemtype="http://schema.org/Organization">
            <a
              class="hd-Header_LogoLink"
              href="{{ routes.root_url }}"
              itemprop="url"
              aria-label="{{ shop.name }}"
            >
              {%- render 'responsive-image' with
                image: section.settings.logo,
                width: 185,
                height: 76 -%}
            </a>
          </div>
        </div>

        <div class="pas-Newsletter_Body">
          <h2 class="pas-Newsletter_Title fz-25_33">{{ 'pages.password.newsletter_title' | t }}</h2>

          <p class="pas-Newsletter_Text fz-13_18">{{ 'pages.password.newsletter_top_text' | t }}</p?

          <div class="pas-Newsletter_Form">
            {%- form 'customer', class: 'pas-Form' -%}
            {%- render 'form-errors', form: form -%}

              {%- if form.posted_successfully? -%}
                <div class="pas-Form_Validation">
                  <ul class="pas-Form_ValidationList">
                    <li class="pas-Form_ValidationListItem">
                      {{ 'pages.password.newsletter_success' | t }}
                    </li>
                  </ul>
                </div>
              {%- else -%}
                <input type="hidden" name="contact[tags]" value="prospect, password page"/>
                <label
                  class="pas-Form_Label util-ScreenReaderOnly"
                  for="email"
                >
                  {{ 'pages.password.newsletter_bottom_text' | t }}
                </label>
                <input
                  class="pas-Form_Input pas-Form_Input-white"
                  type="email"
                  name="contact[email]"
                  id="Email"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  placeholder="{{ 'pages.password.newsletter_placeholder' | t }}"
                />
              {%- endif -%}

              <div class="pas-Form_Row">
                <button class="pas-Form_Button" type="submit">
                  <span class="pas-Form_ButtonText">{{ 'pages.contact.submit' | t }}</span>

                  <span class="pas-Form_ButtonIcon">
                  {%- render 'bao-arrow' -%}
                </span>
                </button>
              </div>
              <p
                class="pas-Newsletter_Text pas-Newsletter_Text-noGap fz-13_18">{{ 'pages.password.newsletter_bottom_text' | t }}</p>
            {%- endform -%}
          </div>
        </div>
      </div>


      <div class="pas-Admin" id="Login" data-el="password.adminSection">
        <div class="pas-Admin_Inner">
          <h2 class="pas-Admin_Title">{{ 'pages.password.admin_title' | t }}</h2>
          <p class="pas-Admin_Text">{{ 'pages.password.admin_text' | t }}</p>

          <div class="pas-Admin_Form">
            {%- form 'storefront_password', class: 'pas-Form' -%}
              {%- if form.errors -%}
                <div class="val-Validation val-Validation-error">
                  {%- for field in form.errors -%}
                    <p class="val-Validation_Text">{{ form.errors.messages[field] }}</p>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <label class="pas-Form_Label util-ScreenReaderOnly"
                     for="password">{{ 'pages.password.admin_label' | t }}</label>
              <input
                class="pas-Form_Input"
                type="password"
                name="password"
                id="Password"
                placeholder="{{ 'pages.password.admin_placeholder' | t }}"
                data-el="password.adminInput"
              />
              <button class="pas-Form_Button btn-Primary" type="submit"
                      name="commit">{{ 'pages.password.admin_submit' | t }}</button>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {% schema %}
    {
    "name": "Password",
    "settings": [
    {
    "type": "image_picker",
    "id": "mobile_image",
    "label": "Mobile Image"
    },
    {
    "type": "image_picker",
    "id": "tablet_image",
    "label": "Tablet Image"
    },
    {
    "type": "image_picker",
    "id": "desktop_image",
    "label": "Desktop Image"
    },
    {
    "type": "image_picker",
    "id": "logo",
    "label": "Image"
    }
    ]
    }
  {% endschema %}
