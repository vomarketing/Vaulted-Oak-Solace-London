{{ 'rich-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign header_mode = section.settings.header_contrast_mode | default: 'dark'
-%}

<rich-text
  class="rich-text"
  id="RichText-{{ section.id }}"
  data-header-mode="{{ header_mode }}"
>
  <div class="rich-text__inner">
    {% if section.settings.text != blank %}
      <div class="rich-text__content rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.link_text != blank %}
      {% if section.settings.link != blank %}
        <a
          href="{{ section.settings.link }}"
          class="rich-text__link"
        >
          {{ section.settings.link_text }}
        </a>
      {% else %}
        <span class="rich-text__link">
          {{ section.settings.link_text }}
        </span>
      {% endif %}
    {% endif %}
  </div>
</rich-text>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text js-section-header-contrast",
  "settings": [
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}