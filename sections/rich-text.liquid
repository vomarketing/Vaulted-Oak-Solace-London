{%- liquid
  assign header_mode = section.settings.header_contrast_mode | default: 'dark'
  assign background_color = section.settings.background_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign max_width_desktop = section.settings.max_width_desktop | at_least: 200
  assign max_width_tablet = section.settings.max_width_tablet | at_least: 200
  assign max_width_mobile = section.settings.max_width_mobile | at_least: 200
  assign disable_full_height = section.settings.disable_full_height | default: false
  assign enable_custom_spacing = section.settings.enable_custom_spacing | default: false
  assign custom_padding_top = section.settings.custom_padding_top | default: 160 | at_least: 0
  assign custom_padding_bottom = section.settings.custom_padding_bottom | default: 160 | at_least: 0
  assign enable_custom_mobile_spacing = section.settings.enable_custom_mobile_spacing | default: false
  assign custom_mobile_padding_top = section.settings.custom_mobile_padding_top | default: 160 | at_least: 0
  assign custom_mobile_padding_bottom = section.settings.custom_mobile_padding_bottom | default: 160 | at_least: 0

  assign text_size = section.settings.text_font_size | default: 'text-reg-14'
  assign text_classes = 'rich-text__content rte ' | append: text_size
  if section.settings.text_uppercase
    assign text_classes = text_classes | append: ' uppercase'
  endif

  assign link_size = section.settings.link_font_size | default: 'text-reg-14'
  assign link_classes = 'rich-text__link ' | append: link_size
  if section.settings.link_uppercase
    assign link_classes = link_classes | append: ' uppercase'
  endif
-%}

{%- if section.settings.text != blank -%}
  <style>
    {{ 'rich-text.css' | inline_asset_content }}
  </style>
  <rich-text
    class="rich-text{% if disable_full_height %} rich-text--non-full-height{% endif %}"
    id="RichText-{{ section.id }}"
    data-header-mode="{{ header_mode }}"
    style="
      --rich-text-background-color: {{ background_color }};
      --rich-text-text-color: {{ text_color }};
      --max-width-desktop: {{ max_width_desktop }}px;
      --max-width-tablet: {{ max_width_tablet }}px;
      --max-width-mobile: {{ max_width_mobile }}px;
      {% if disable_full_height and enable_custom_spacing %}
        --rich-text-custom-padding-top: {{ custom_padding_top }}px;
        --rich-text-custom-padding-bottom: {{ custom_padding_bottom }}px;
      {% endif %}
      {% if disable_full_height and enable_custom_mobile_spacing %}
        --rich-text-custom-mobile-padding-top: {{ custom_mobile_padding_top }}px;
        --rich-text-custom-mobile-padding-bottom: {{ custom_mobile_padding_bottom }}px;
      {% endif %}
    "
  >
    <div class="rich-text__inner">
      {% if section.settings.text != blank %}
        <div class="{{ text_classes }}">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.link_text != blank %}
        {% if section.settings.link != blank %}
          <a
            href="{{ section.settings.link }}"
            class="{{ link_classes }}"
          >
            {{ section.settings.link_text }}
          </a>
        {% else %}
          <span class="{{ link_classes }}">
            {{ section.settings.link_text }}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </rich-text>
{%- endif -%}

{%- schema -%}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text js-section-header-contrast",
  "settings": [
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_full_height",
      "label": "Disable full-screen height",
      "info": "Uses the content's natural height and enables custom desktop and mobile spacing controls.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Use custom desktop spacing",
      "info": "Applies at 980px and above. When disabled, the existing 160px spacing is preserved.",
      "default": false,
      "visible_if": "{{ section.settings.disable_full_height == true }}"
    },
    {
      "type": "range",
      "id": "custom_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 160,
      "visible_if": "{{ section.settings.disable_full_height == true and section.settings.enable_custom_spacing == true }}"
    },
    {
      "type": "range",
      "id": "custom_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 160,
      "visible_if": "{{ section.settings.disable_full_height == true and section.settings.enable_custom_spacing == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_spacing",
      "label": "Use custom mobile spacing",
      "info": "Applies below 980px. When disabled, the existing 160px spacing is preserved.",
      "default": false,
      "visible_if": "{{ section.settings.disable_full_height == true }}"
    },
    {
      "type": "range",
      "id": "custom_mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 160,
      "visible_if": "{{ section.settings.disable_full_height == true and section.settings.enable_custom_mobile_spacing == true }}"
    },
    {
      "type": "range",
      "id": "custom_mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 160,
      "visible_if": "{{ section.settings.disable_full_height == true and section.settings.enable_custom_mobile_spacing == true }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_font_size",
      "label": "Text font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "text_uppercase",
      "label": "Text uppercase",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "link_font_size",
      "label": "Link font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "link_uppercase",
      "label": "Link uppercase",
      "default": false
    },
    {
      "type": "number",
      "id": "max_width_desktop",
      "label": "Max Width Desktop (px)",
      "default": 910,
      "info": "Minimum 200px"
    },
    {
      "type": "number",
      "id": "max_width_tablet",
      "label": "Max Width Tablet (px)",
      "default": 589,
      "info": "Minimum 200px"
    },
    {
      "type": "number",
      "id": "max_width_mobile",
      "label": "Max Width Mobile (px)",
      "default": 305,
      "info": "Minimum 200px"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{%- endschema -%}
