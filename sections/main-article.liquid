<article class="art-Article" role="article">
  {%- if article.image != blank or settings.blog_fallback_image != blank -%}
  <header class="art-Article_Header">
    <div class="art-Article_ImageContainer">
      {%- if article.image != blank -%}
        {%- render 'responsive-image',
          image: article.image,
          width: 1440,
          height: 900
        -%}
      {%- else -%}
        {%- render 'responsive-image',
          image: settings.blog_fallback_image,
          width: 1440,
          height: 900
        -%}
      {%- endif -%}
    </div>
  </header>
  {%- endif -%}
  <div class="art-Article_Inner lyt-Container">
    <div class="art-Article_Body art-Article_Body-skinny">
      <h1 class="art-Article_Title fz-25_25">{{ article.title }}</h1>

      <p class="art-Article_Meta">
        {{ article.published_at | time_tag: format: 'month_day_year' }} | {{ blog.title }} | {{ article.author }}
      </p>

      <div class="art-Article_Text rte-RichText">
        {{ article.content }}
      </div>

      <div class="art-Article_Sharing">
        {%- render 'article-sharing',
          share_title: article.title,
          share_permalink: article.url,
          share_image: article.image
        -%}
      </div>

      {%- if blog.comments_enabled? -%}
        <div class="art-Article_Comments" id="comments">
          {%- render 'article-comments' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</article>

{%- render 'structured-data-article', article: article -%}

{% schema %}
{
  "name": "Main article",
  "settings": []
}
{% endschema %}
