{%- comment -%}
  Promo bar: a fixed bar pinned to the top or bottom of the viewport.
  Lives in the header/footer section groups so it can appear on any
  template; each instance decides for itself which pages it shows on, so
  several bars can run side by side on different pages. When more than one
  bar matches a page, promo-bar.js stacks them.
{%- endcomment -%}

{%- liquid
  assign should_show = false

  if section.settings.enabled and section.settings.text != blank
    if section.settings.show_on == 'all'
      assign should_show = true
    else
      case request.page_type
        when 'index'
          assign should_show = section.settings.show_on_index
        when 'collection', 'list-collections'
          assign should_show = section.settings.show_on_collection
        when 'product'
          assign should_show = section.settings.show_on_product
        when 'page'
          assign should_show = section.settings.show_on_page
        when 'blog', 'article'
          assign should_show = section.settings.show_on_blog
        when 'search'
          assign should_show = section.settings.show_on_search
        when 'cart'
          assign should_show = section.settings.show_on_cart
      endcase

      comment
        Specific paths, one per line, matched against the path without its
        locale/market prefix (e.g. /en-us). A trailing * matches as a prefix.
      endcomment
      if should_show == false and section.settings.paths != blank
        assign current_path = request.path | downcase
        if routes.root_url != '/'
          assign current_path = current_path | remove_first: routes.root_url
        endif
        if current_path == blank
          assign current_path = '/'
        endif

        assign path_lines = section.settings.paths | newline_to_br | split: '<br />'
        for line in path_lines
          assign target = line | strip | downcase
          if target == blank
            continue
          endif

          assign last_char = target | slice: -1
          if last_char == '*'
            assign prefix = target | remove_last: '*'
            assign current_prefix = current_path | slice: 0, prefix.size
            if current_prefix == prefix
              assign should_show = true
              break
            endif
          else
            if target != '/' and last_char == '/'
              assign target = target | remove_last: '/'
            endif
            if current_path == target
              assign should_show = true
              break
            endif
          endif
        endfor
      endif
    endif
  endif
-%}

{%- if should_show -%}
  <style>
    {{ 'promo-bar.css' | inline_asset_content }}
  </style>
  <script src="{{ 'promo-bar.js' | asset_url }}" defer="defer"></script>

  <aside
    class="pb-PromoBar pb-PromoBar-{{ section.settings.position }}"
    data-promo-bar
    data-promo-bar-position="{{ section.settings.position }}"
    aria-label="{{ 'layout.promo_bar.label' | t }}"
    style="--promo-bar-bg: {{ section.settings.background_color }}; --promo-bar-fg: {{ section.settings.text_color }};"
  >
    {%- if section.settings.popup_enabled -%}
      {%- liquid
        assign panel_id = 'PromoBarPanel-' | append: section.id
        assign title_id = 'PromoBarPanelTitle-' | append: section.id
      -%}
      <button
        class="pb-PromoBar_Inner pb-PromoBar_Toggle"
        type="button"
        aria-expanded="false"
        aria-controls="{{ panel_id }}"
        data-promo-bar-toggle
      >
        <span class="pb-PromoBar_Text">{{ section.settings.text | escape }}</span>
        <span class="pb-PromoBar_Icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M0 5h10" stroke="currentColor"/>
            <path class="pb-PromoBar_IconVertical" d="M5 0v10" stroke="currentColor"/>
          </svg>
        </span>
      </button>

      <div
        class="pb-PromoBar_Panel"
        id="{{ panel_id }}"
        role="region"
        {% if section.settings.popup_heading != blank -%}
          aria-labelledby="{{ title_id }}"
        {%- else -%}
          aria-label="{{ section.settings.text | escape }}"
        {%- endif %}
        data-promo-bar-panel
        hidden
      >
        <div class="pb-PromoBar_PanelHeader">
          {%- if section.settings.popup_heading != blank -%}
            <p class="pb-PromoBar_PanelTitle" id="{{ title_id }}">{{ section.settings.popup_heading | escape }}</p>
          {%- endif -%}
          <button class="pb-PromoBar_Close" type="button" data-promo-bar-close>
            {{- 'layout.promo_bar.close' | t -}}
          </button>
        </div>

        <div class="pb-PromoBar_PanelBody">
          {%- if section.settings.popup_text != blank -%}
            <div class="pb-PromoBar_PanelText">{{ section.settings.popup_text }}</div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            {%- if section.settings.button_action == 'newsletter' -%}
              {%- comment -%}
                Opens the footer newsletter popup. promo-bar.js wires it up and
                reveals it only if that popup is on the page.
              {%- endcomment -%}
              <button class="pb-PromoBar_Cta" type="button" data-promo-bar-newsletter hidden>
                {{- section.settings.button_label | escape -}}
              </button>
            {%- elsif section.settings.button_link != blank -%}
              <a class="pb-PromoBar_Cta" href="{{ section.settings.button_link }}">
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- elsif section.settings.link != blank -%}
      <a class="pb-PromoBar_Inner pb-PromoBar_Link" href="{{ section.settings.link }}">
        <span class="pb-PromoBar_Text">{{ section.settings.text | escape }}</span>
      </a>
    {%- else -%}
      <div class="pb-PromoBar_Inner">
        <p class="pb-PromoBar_Text">{{ section.settings.text | escape }}</p>
      </div>
    {%- endif -%}
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Promo bar",
  "class": "shopify-section--promo-bar",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show promo bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Spring / Summer 27 Coming Soon"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole bar clickable.",
      "visible_if": "{{ section.settings.popup_enabled == false }}"
    },
    {
      "type": "header",
      "content": "Popup",
      "info": "Clicking the bar opens a panel attached to it, in the same colours."
    },
    {
      "type": "checkbox",
      "id": "popup_enabled",
      "label": "Enable popup",
      "default": false
    },
    {
      "type": "text",
      "id": "popup_heading",
      "label": "Heading",
      "visible_if": "{{ section.settings.popup_enabled }}"
    },
    {
      "type": "richtext",
      "id": "popup_text",
      "label": "Text",
      "visible_if": "{{ section.settings.popup_enabled }}"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "visible_if": "{{ section.settings.popup_enabled }}"
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button action",
      "options": [
        { "value": "link", "label": "Go to link" },
        { "value": "newsletter", "label": "Open newsletter popup" }
      ],
      "default": "link",
      "info": "The newsletter popup needs \"Enable newsletter popup\" turned on in the Footer section. If it's off, the button is hidden.",
      "visible_if": "{{ section.settings.popup_enabled }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.popup_enabled and section.settings.button_action == 'link' }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "top", "label": "Top of page" },
        { "value": "bottom", "label": "Bottom of page" }
      ],
      "default": "bottom"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Visibility",
      "info": "Add more promo bars to show different messages on different pages. If two bars match the same page and position they stack."
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "all", "label": "All pages" },
        { "value": "selected", "label": "Selected pages only" }
      ],
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "show_on_index",
      "label": "Homepage",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "checkbox",
      "id": "show_on_collection",
      "label": "Collection pages",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "checkbox",
      "id": "show_on_product",
      "label": "Product pages",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "checkbox",
      "id": "show_on_page",
      "label": "Content pages",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "checkbox",
      "id": "show_on_blog",
      "label": "Blog and article pages",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "checkbox",
      "id": "show_on_search",
      "label": "Search page",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "checkbox",
      "id": "show_on_cart",
      "label": "Cart page",
      "default": false,
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    },
    {
      "type": "textarea",
      "id": "paths",
      "label": "Specific pages",
      "info": "One URL path per line, e.g. /pages/about or /collections/bridal. End with * to include everything beneath it, e.g. /collections/resort*",
      "visible_if": "{{ section.settings.show_on == 'selected' }}"
    }
  ],
  "presets": [
    {
      "name": "Promo bar"
    }
  ]
}
{% endschema %}
