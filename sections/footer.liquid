<footer class="ft-Footer" aria-label="Footer">
  <div class="ft-Footer_Inner lyt-Container">
    <div class="ft-Footer_Body">
      <a class="ft-Footer_Logo ft-Footer_Logo-large" href="{{ routes.root_url }}">
        {%- render 'bao-logo-large' -%}
      </a>

      <a class="ft-Footer_Logo ft-Footer_Logo-small" href="{{ routes.root_url }}">
        {%- render 'bao-logo' -%}
      </a>

      {%- if section.settings.navigation != blank -%}
        <div class="ft-Footer_Navigation">
          <div class="ft-Footer_Items">
            {%- for link in linklists[section.settings.navigation].links -%}
              <div class="ft-Footer_Item">
                <a class="ft-Footer_Link" href="{{ link.url }}">{{ link.title }}</a>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="ft-Footer_Text">
        {%- assign current_year = 'now' | date: "%Y" -%}

        {{ 'layout.footer.copyright' | t: year: current_year }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "navigation",
      "label": "Navigation"
    }
  ]
}
{% endschema %}
