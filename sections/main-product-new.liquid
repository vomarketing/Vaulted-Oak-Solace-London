<script type="application/json" class="js-pdp-klaviyo-data">
{
  "Name": {{ product.title | json }},
  "ProductID": {{ product.id | json }},
  "Categories": {{ product.collections | map: 'title' | json }},
  "ImageURL": "https:{{ product.featured_media | image_url: width: 600 }}",
  "URL": "{{ shop.secure_url }}{{ product.url }}",
  "Brand": {{ product.vendor | json }},
  "Price": {{ product.price | money | json }},
  "CompareAtPrice": {{ product.compare_at_price_max | money | json }}
}
</script>

{{ 'main-product-new.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-product-new.js' | asset_url }}" defer="defer"></script>

{{ 'product-buy-buttons-new.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-buy-buttons-new.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign option_names = product.options | join: ',' | downcase
  assign has_size_option = false
  if option_names contains 'size'
    assign has_size_option = true
  endif
-%}

<product-fullscreen
  class="pdp-new js-pdp-new"
  id="Product-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  data-has-size-option="{{ has_size_option }}"
>
  <div class="pdp-new__main">
    <div class="pdp-new__gallery-column js-pdp-gallery-column">
      {%- render 'product-media-gallery-new', product: product, section: section -%}
    </div>

    <div class="pdp-new__content-column js-pdp-content-column">
      {%- render 'product-content-new', product: product, section: section, current_variant: current_variant -%}
    </div>
  </div>

  {%- render 'product-media-zoom-modal-new', product: product -%}
</product-fullscreen>

<product-fullscreen-anchor data-position="top"></product-fullscreen-anchor>
<product-fullscreen-anchor data-position="bottom"></product-fullscreen-anchor>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {%- if product.featured_media -%}
    "image": [
      "https:{{ product.featured_media | image_url: width: 1400 }}"
    ],
  {%- endif -%}
  "description": {{ product.description | strip_html | json }},
  {%- if current_variant.sku != blank -%}
    "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  {%- if product.variants.size > 0 -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": "{{ variant.price | divided_by: 100.00 }}",
          "priceCurrency": "{{ cart.currency.iso_code | default: shop.currency }}",
          "url": "{{ shop.url }}{{ variant.url }}",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.image -%}
            "image": "https:{{ variant.image | image_url: width: 1000 }}",
          {%- endif -%}
          "name": {{ variant.title | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  {%- endif -%}
}
</script>

{% comment %}
  Klaviyo Abandon Browse & Add-to-cart tracking
{% endcomment %}
<script>
  (function () {
    var _learnq = window._learnq || [];
    var item = {
      Name: {{ product.title | json }},
      ProductID: {{ product.id | json }},
      Categories: {{ product.collections | map: 'title' | json }},
      ImageURL: "https:{{ product.featured_image | image_url: width: 600 }}",
      URL: "{{ shop.secure_url }}{{ product.url }}",
      Brand: {{ product.vendor | json }},
      Price: {{ product.price | money | json }},
      CompareAtPrice: {{ product.compare_at_price_max | money | json }}
    };

    _learnq.push(['track', 'Viewed Product', item]);
    _learnq.push(['trackViewedItem', {
      Title: item.Name,
      ItemId: item.ProductID,
      Categories: item.Categories,
      ImageUrl: item.ImageURL,
      Url: item.URL,
      Metadata: {
        Brand: item.Brand,
        Price: item.Price,
        CompareAtPrice: item.CompareAtPrice
      }
    }]);

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('#AddToCart, .js-product-add-to-cart, [data-el="product-form.submit"], [name="add"], .js-pdp-submit');
      if (btn) {
        _learnq.push(['track', 'Added to Cart', item]);
      }
    });
  })();
</script>

