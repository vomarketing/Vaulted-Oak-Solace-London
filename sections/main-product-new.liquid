{{ 'main-product-new.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-product-new.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_size_option = false

  for option in product.options
    assign downcased_name = option | downcase
    if downcased_name contains 'size'
      assign has_size_option = true
      break
    endif
  endfor
-%}

<product-fullscreen
  class="pdp-new js-pdp-new prd-Detail"
  id="Product-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product"
  data-product-handle="{{ product.handle }}"
  data-has-size-option="{{ has_size_option }}"
  data-size-chosen="{% if has_size_option %}false{% else %}true{% endif %}"
>
  <!-- 1. Main 2-Column Section (Gallery + Sticky Content) -->
  <div class="pdp-new__main prd-Detail_Inner">
    <div class="pdp-new__gallery-column prd-Detail_Column prd-Detail_Column-image">
      {%- render 'product-media-gallery-new', product: product, section: section -%}
    </div>

    <div class="pdp-new__content-column prd-Detail_Column prd-Detail_Column-content">
      {%- render 'product-content-new', product: product, section: section, current_variant: current_variant -%}
    </div>
  </div>

  <!-- 3. Back to Collection Link -->
  {%- if collection -%}
    <div class="pg-Back">
      <div class="pg-Back_Inner lyt-Container">
        <div class="pg-Back_Body">
          <a class="pg-Back_Link text-med-10 uppercase" href="{{ collection.url }}">
            <span class="pg-Back_Icon">{%- render 'bao-chevron-left' -%}</span>
            <span class="pg-Back_Text">{{ 'products.product.back' | t | default: 'Back' }}</span>
          </a>
        </div>
      </div>
    </div>
  {%- endif -%}
</product-fullscreen>

<!-- =============================================================================
     SEO JSON-LD Structured Data
     ============================================================================= -->
<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {%- if product.featured_media -%}
    "image": [
      "https:{{ product.featured_media | image_url: width: 1400 }}"
    ],
  {%- endif -%}
  "description": {{ product.description | strip_html | json }},
  {%- if current_variant.sku != blank -%}
    "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Thing",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  {%- if product.variants.size > 0 -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : "{{ variant.price | divided_by: 100.00 }}",
          "priceCurrency" : "{{ shop.currency }}",
          "url" : "{{ shop.url }}{{ variant.url }}",
          "itemOffered" : {
            "@type" : "Product",
            {%- if variant.image -%}
              "image": "http:{{ variant.image | image_url: width: 1000 }}",
            {%- endif -%}
            "name" : {{ variant.title | json }},
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            "url": "{{ shop.url }}{{ variant.url }}"
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  {%- endif -%}
}
</script>

<!-- =============================================================================
     Back-in-Stock (BIS) Popover Integration
     ============================================================================= -->
<script type="text/javascript">
if (typeof(BIS) !== 'undefined') {
  if (BIS.urlIsProductPage()) {
    BISPopover.ready.then(function() {
      var variant_id;
      var reload = function() {
        try {
          var variant = BIS.detectVariant(BIS.popup);
          if (variant && BIS.popup.variantIsUnavailable(variant)) {
            variant_id = variant.id;
          }
        } catch (e) {};
      };

      var elm = $('.js-pdp-master-select');
      if (elm[0]) {
        elm.on('change', reload);
      }
    });
  }
}
</script>

<!-- =============================================================================
     Klaviyo Product & Add to Cart Tracking
     ============================================================================= -->
<script type="text/javascript">
  var _learnq = _learnq || [];
  var klaviyoItem = {
    Name: {{ product.title | json }},
    ProductID: {{ product.id | json }},
    Categories: {{ product.collections | map: 'title' | json }},
    ImageURL: "https:{{ product.featured_media | image_url: width: 600 }}",
    URL: "{{ shop.secure_url }}{{ product.url }}",
    Brand: {{ product.vendor | json }},
    Price: {{ product.price | money | json }},
    CompareAtPrice: {{ product.compare_at_price_max | money | json }}
  };
  _learnq.push(['track', 'Viewed Product', klaviyoItem]);
  _learnq.push(['trackViewedItem', {
    Title: klaviyoItem.Name,
    ItemId: klaviyoItem.ProductID,
    Categories: klaviyoItem.Categories,
    ImageUrl: klaviyoItem.ImageURL,
    Url: klaviyoItem.URL,
    Metadata: {
      Brand: klaviyoItem.Brand,
      Price: klaviyoItem.Price,
      CompareAtPrice: klaviyoItem.CompareAtPrice
    }
  }]);

  document.addEventListener('DOMContentLoaded', function() {
    var submitBtn = document.querySelector('.js-pdp-submit');
    if (submitBtn) {
      submitBtn.addEventListener('click', function() {
        _learnq.push(['track', 'Added to Cart', klaviyoItem]);
      });
    }
  });
</script>

