<style>
  {{ 'custom-cart.css' | inline_asset_content }}
</style>
<script src="{{ 'custom-cart.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign has_final_sale = false
  for item in cart.items
    if item.variant.compare_at_price != blank
      if item.variant.compare_at_price > item.variant.price
        assign has_final_sale = true
        break
      endif
    endif
  endfor

  assign show_duties = false
  if localization.market.metafields.custom.show_duties_and_taxes.value == true
    assign show_duties = true
  endif

  assign duties_note = settings.mbg_note_default
  if show_duties
    assign duties_note = settings.mbg_note_included
  endif
-%}

<section
  class="bag-Page{% if cart.item_count == 0 %} bag-Page-empty{% endif %}"
  data-bag
  data-section-id="{{ section.id }}"
  data-cart-count="{{ cart.item_count }}"
  data-error-message="{{ 'cart.bag.error' | t | escape }}"
>
  {%- if cart.item_count == 0 -%}
    <div class="bag-Page_Empty">
      <h1 class="bag-Page_Title">{{ 'cart.bag.title' | t: count: cart.item_count }}</h1>

      {%- render 'cart-empty-content' -%}
    </div>

    <dialog class="bag-Info" id="BagInfo" aria-labelledby="BagInfoTitle" data-bag-info>
      <header class="bag-Info_Header">
        <h2 class="bag-Info_Title" id="BagInfoTitle">{{ 'cart.bag.shipping_returns' | t }}</h2>
        <button class="bag-Info_Close" type="button" data-bag-info-close>{{ 'cart.bag.close' | t }}</button>
      </header>

      <div class="bag-Info_Body">
        {%- render 'shipping-returns-content' -%}
      </div>
    </dialog>
  {%- else -%}
    <div class="bag-Page_Inner">
      <div class="bag-Page_Main">
        <h1 class="bag-Page_Title">{{ 'cart.bag.title' | t: count: cart.item_count }}</h1>

        {%- if has_final_sale -%}
          <p class="bag-Page_Notice">
            {{- settings.mbg_final_sale_message | default: 'All online archive sale items are final sale. No returns or exchanges.' | escape -}}
          </p>
        {%- endif -%}

        <div class="bag-Page_Items">
          {%- for item in cart.items -%}
            {%- render 'bag-line-item', line_item: item -%}
          {%- endfor -%}
        </div>
      </div>

      <aside class="bag-Page_Aside">
        <div class="bag-Summary">
          <dl class="bag-Summary_Rows">
            {%- if cart.requires_shipping -%}
              <div class="bag-Summary_Row">
                <dt>{{ 'cart.bag.shipping' | t }}</dt>
                <dd>{{ 'cart.bag.shipping_calculated' | t }}</dd>
              </div>
            {%- endif -%}

            {%- if show_duties -%}
              <div class="bag-Summary_Row">
                <dt>{{ 'cart.bag.duties' | t }}</dt>
                <dd>{{ 'cart.bag.duties_included' | t }}</dd>
              </div>
            {%- endif -%}

            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="bag-Summary_Row">
                <dt>{{ discount.title | escape }}</dt>
                <dd>−{{ discount.total_allocated_amount | money }}</dd>
              </div>
            {%- endfor -%}

            <div class="bag-Summary_Row">
              <dt>{{ 'cart.bag.subtotal' | t }}</dt>
              <dd>{{ cart.total_price | money }}</dd>
            </div>
          </dl>

          <form class="bag-Summary_Form" action="{{ routes.cart_url }}" method="post" novalidate>
            <button class="bag-Summary_Checkout" type="submit" name="checkout">
              {{- 'cart.bag.checkout' | t -}}
            </button>
          </form>

          {%- if duties_note != blank -%}
            <p class="bag-Summary_Note">{{ duties_note | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="bag-Page_Accordions">
            {%- for block in section.blocks -%}
              <details class="bag-Accordion" name="bag-accordion" data-bag-accordion {{ block.shopify_attributes }}>
                <summary class="bag-Accordion_Summary">
                  <span class="bag-Accordion_Title">{{ block.settings.title }}</span>
                  {%- render 'icons', icon: 'arrow-down', class: 'bag-Accordion_Icon' -%}
                </summary>

                <div class="bag-Accordion_Content">
                  {%- if block.settings.content != blank -%}
                    <div class="bag-Accordion_Text">{{ block.settings.content }}</div>
                  {%- endif -%}

                  {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
                    <ul class="bag-Accordion_Payments">
                      {%- for type in shop.enabled_payment_types -%}
                        <li class="bag-Accordion_Payment">{{ type | payment_type_svg_tag }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </aside>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    {
      "type": "paragraph",
      "content": "The final sale message and the note below the checkout button are shared with the mini bag, managed in Theme settings > Cart."
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Need Help?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "show_payment_icons",
          "label": "Show payment icons",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
