<style>
  {{ 'custom-cart.css' | inline_asset_content }}
</style>
<script src="{{ 'custom-cart.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign has_final_sale = false
  for item in cart.items
    if item.product.metafields.custom.final_sale.value == true
      assign has_final_sale = true
      break
    endif
  endfor

  assign shipping_price = nil
  assign estimated_total = cart.total_price
  if section.settings.shipping_amount != blank
    assign shipping_price = section.settings.shipping_amount | times: 100 | round
    assign estimated_total = estimated_total | plus: shipping_price
  endif
-%}

<section
  class="bag-Page{% if cart.item_count == 0 %} bag-Page-empty{% endif %}"
  data-bag
  data-section-id="{{ section.id }}"
  data-cart-count="{{ cart.item_count }}"
  data-error-message="{{ 'cart.bag.error' | t | escape }}"
>
  {%- if cart.item_count == 0 -%}
    <div class="bag-Page_Empty">
      <h1 class="bag-Page_Title">{{ 'cart.bag.title' | t: count: cart.item_count }}</h1>

      {%- render 'cart-empty-content' -%}
    </div>
  {%- else -%}
    <div class="bag-Page_Inner">
      <div class="bag-Page_Main">
        <h1 class="bag-Page_Title">{{ 'cart.bag.title' | t: count: cart.item_count }}</h1>

        {%- if has_final_sale and section.settings.final_sale_message != blank -%}
          <p class="bag-Page_Notice">{{ section.settings.final_sale_message }}</p>
        {%- endif -%}

        <div class="bag-Page_Items">
          {%- for item in cart.items -%}
            {%- render 'bag-line-item', line_item: item -%}
          {%- endfor -%}
        </div>
      </div>

      <aside class="bag-Page_Aside">
        <div class="bag-Summary">
          <dl class="bag-Summary_Rows">
            {%- if section.settings.shipping_label != blank -%}
              <div class="bag-Summary_Row">
                <dt>{{ section.settings.shipping_label }}</dt>
                <dd>
                  {%- if shipping_price != nil -%}
                    {{ shipping_price | money }}
                  {%- else -%}
                    {{ section.settings.shipping_fallback }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}

            {%- if section.settings.duties_label != blank -%}
              <div class="bag-Summary_Row">
                <dt>{{ section.settings.duties_label }}</dt>
                <dd>{{ section.settings.duties_value }}</dd>
              </div>
            {%- endif -%}

            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="bag-Summary_Row">
                <dt>{{ discount.title }}</dt>
                <dd>-{{ discount.total_allocated_amount | money }}</dd>
              </div>
            {%- endfor -%}

            <div class="bag-Summary_Row">
              <dt>{{ section.settings.total_label }}</dt>
              <dd>{{ estimated_total | money }}</dd>
            </div>
          </dl>

          <form class="bag-Summary_Form" action="{{ routes.cart_url }}" method="post" novalidate>
            <button class="bag-Summary_Checkout" type="submit" name="checkout">
              {{- section.settings.checkout_label -}}
            </button>
          </form>

          {%- render 'cart-duties-note' -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="bag-Page_Accordions">
            {%- for block in section.blocks -%}
              <details class="bag-Accordion" {{ block.shopify_attributes }}>
                <summary class="bag-Accordion_Summary">
                  <span class="bag-Accordion_Title">{{ block.settings.title }}</span>
                  {%- render 'icons', icon: 'arrow-down', class: 'bag-Accordion_Icon' -%}
                </summary>

                <div class="bag-Accordion_Content">
                  {%- if block.settings.content != blank -%}
                    <div class="bag-Accordion_Text">{{ block.settings.content }}</div>
                  {%- endif -%}

                  {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
                    <ul class="bag-Accordion_Payments">
                      {%- for type in shop.enabled_payment_types -%}
                        <li class="bag-Accordion_Payment">{{ type | payment_type_svg_tag }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </aside>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    {
      "type": "header",
      "content": "Items"
    },
    {
      "type": "text",
      "id": "final_sale_message",
      "label": "Final sale message",
      "info": "Shown when the bag contains a product with the custom.final_sale metafield set to true.",
      "default": "All online archive sale items are final sale. No returns or exchanges."
    },
    {
      "type": "header",
      "content": "Summary"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Shipping"
    },
    {
      "type": "number",
      "id": "shipping_amount",
      "label": "Shipping amount",
      "info": "In the market currency, e.g. 35. Added to the estimated total. Use a market-specific template for other markets."
    },
    {
      "type": "text",
      "id": "shipping_fallback",
      "label": "Shipping text when no amount is set",
      "default": "Calculated at checkout"
    },
    {
      "type": "text",
      "id": "duties_label",
      "label": "Duties label",
      "default": "Duties and Taxes"
    },
    {
      "type": "text",
      "id": "duties_value",
      "label": "Duties value",
      "default": "Included"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Estimated Total"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Checkout"
    },
    {
      "type": "paragraph",
      "content": "The duties note below the checkout button is managed in Theme settings > Cart."
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Need Help?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "show_payment_icons",
          "label": "Show payment icons",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
