{%- liquid
  assign slide_count = section.blocks.size
  assign enable_slider = section.settings.enable_slider

  if slide_count <= 1
    assign enable_slider = false
  endif
-%}

{%- if enable_slider -%}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{%- endif -%}

<section
  class="sec-Hero{% if section.settings.enable_slider %} sec-Hero-slider{% endif %} js-Animate"
  data-animation="Fade"
  data-section-id="{{ section.id }}"
  data-section-type="hero"
>
  <div
    class="sec-Hero_Swiper swiper"
    data-hero-swiper="{{ section.id }}"
    data-slider-enabled="{{ enable_slider }}"
    data-mobile-swipe="{{ section.settings.enable_mobile_swipe }}"
  >
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.image
          assign mobile_image = block.settings.mobile_image

          if mobile_image == blank
            assign mobile_image = desktop_image
          endif
        -%}

        <div
          class="sec-Hero_Slide swiper-slide{% if block.settings.link != blank %} util-FauxLink{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if mobile_image != blank -%}
            <div class="sec-Hero_ImageContainer sec-Hero_ImageContainer-mobile">
              <div class="sec-Hero_Image">
                {%- render 'responsive-image',
                  image: mobile_image,
                  width: mobile_image.width,
                  height: mobile_image.height
                -%}
              </div>
            </div>
          {%- endif -%}

          {%- if desktop_image != blank -%}
            <div class="sec-Hero_ImageContainer sec-Hero_ImageContainer-desktop">
              <div class="sec-Hero_Image">
                {%- render 'responsive-image',
                  image: desktop_image,
                  width: 4472,
                  height: 2360
                -%}
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.title != blank or block.settings.text != blank -%}
            <div class="sec-Hero_Content lyt-Container">
              {%- if block.settings.title != blank -%}
                <h1 class="sec-Hero_Title fz-56_56">
                  {{ block.settings.title | newline_to_br }}
                </h1>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="sec-Hero_Text fz-12_12">
                  {{ block.settings.text | newline_to_br }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            <a class="sec-Hero_Link util-FauxLink_Link" href="{{ block.settings.link }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if enable_slider and section.settings.show_arrows -%}
      <button
        type="button"
        class="sec-Hero_Arrow sec-Hero_Arrow-prev sec-Hero_Arrow-{{ section.settings.arrow_color }}"
        data-hero-arrow-prev="{{ section.id }}"
        aria-label="Previous slide"
      >
        <span></span>
      </button>

      <button
        type="button"
        class="sec-Hero_Arrow sec-Hero_Arrow-next sec-Hero_Arrow-{{ section.settings.arrow_color }}"
        data-hero-arrow-next="{{ section.id }}"
        aria-label="Next slide"
      >
        <span></span>
      </button>
    {%- endif -%}
  </div>
</section>

<style>
  .sec-Hero {
    position: relative;
    overflow: hidden;
  }
  .sec-Hero_Swiper,
  .sec-Hero_Slide {
    width: 100%;
    height: 100%;
  }
  .sec-Hero_Slide {
    position: relative;
    overflow: hidden;
  }
  .sec-Hero_ImageContainer {
    width: 100%;
  }
  .sec-Hero_ImageContainer-mobile {
    display: none;
  }
  .sec-Hero_Image,
  .sec-Hero_Image img,
  .sec-Hero_Image picture {
    width: 100%;
    display: block;
  }
  .sec-Hero_Image img {
    height: auto;
  }
  .sec-Hero_Content {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
  }
  .sec-Hero_Arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transform: translateY(-50%);
  }
  .sec-Hero_Arrow-prev {
    left: 2rem;
  }
  .sec-Hero_Arrow-next {
    right: 2rem;
  }
  .sec-Hero_Arrow span {
    display: block;
    width: 1rem;
    height: 1rem;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
  }
  .sec-Hero_Arrow-prev span {
    transform: rotate(-135deg);
  }
  .sec-Hero_Arrow-next span {
    transform: rotate(45deg);
  }
  .sec-Hero_Arrow-black {
    color: #000;
  }
  .sec-Hero_Arrow-white {
    color: #fff;
  }
  @media screen and (max-width: 767px) {
    .sec-Hero_ImageContainer-desktop {
      display: none;
    }
    .sec-Hero_ImageContainer-mobile {
      display: block;
    }
    .sec-Hero_Arrow-next {
      right: 1rem;
    }
    .sec-Hero_Arrow-prev {
      left: 1.5rem;
    }
  }
</style>

{%- if enable_slider -%}

  <script>
    function initHeroSwiper{{ section.id | replace: '-', '_' }}() {
      var heroSwiperEl = document.querySelector('[data-hero-swiper="{{ section.id }}"]');

      if (!heroSwiperEl || heroSwiperEl.dataset.sliderEnabled !== 'true') {
        return;
      }

      if (heroSwiperEl.swiper) {
        heroSwiperEl.swiper.destroy(true, true);
      }

      var mobileSwipeEnabled = heroSwiperEl.dataset.mobileSwipe === 'true';

      new Swiper(heroSwiperEl, {
        slidesPerView: 1,
        loop: true,
        speed: 700,
        effect: 'slide',
        allowTouchMove: true,
        navigation: {
          nextEl: '[data-hero-arrow-next="{{ section.id }}"]',
          prevEl: '[data-hero-arrow-prev="{{ section.id }}"]'
        },
        breakpoints: {
          0: {
            allowTouchMove: mobileSwipeEnabled
          },
          768: {
            allowTouchMove: true
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initHeroSwiper{{ section.id | replace: '-', '_' }});

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initHeroSwiper{{ section.id | replace: '-', '_' }}();
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "arrow_color",
      "label": "Arrow colour",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "black",
          "label": "Black"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_swipe",
      "label": "Enable swipe on mobile",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "4472x2360"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "2525x4472"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "category": "Homepage",
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}