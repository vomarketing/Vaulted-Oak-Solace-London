<style>
  {{ '404-header.css' | inline_asset_content }}
</style>

<div class="page-404">
  <div class="page-404__inner">
    {%- if section.settings.title != blank -%}
      <h1 class="page-404__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="page-404__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.link_text != blank -%}
      <a class="page-404__link" href="{{ section.settings.link | default: routes.root_url }}">
        {{- section.settings.link_text -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 Hero",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "404 Error"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page you're looking for can't be found"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Back to Home"
    }
  ]
}
{% endschema %}
