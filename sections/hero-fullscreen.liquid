{% comment %} hero-fullscreen.css is inlined once in layout/theme.liquid because this section can repeat on a page. {% endcomment %}
<script src="{{ 'hero-fullscreen.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign header_mode = section.settings.header_contrast_mode | default: 'light'
  assign text_color = section.settings.text_color | default: 'white'
  assign background_color = section.settings.background_color | default: '#000000'
  assign content_vertical_alignment = section.settings.content_vertical_alignment | default: 'bottom'
  assign is_video = false
  assign video_desktop_url = ''
  assign video_mobile_url = ''
  if section.settings.media_type == 'video'
    assign is_video = true
    if section.settings.video_desktop != blank
      assign video_desktop_url = section.settings.video_desktop.sources[1].url | default: section.settings.video_desktop.sources[0].url
    elsif section.settings.video_url_desktop != blank
      assign video_desktop_url = section.settings.video_url_desktop
    endif

    if section.settings.video_mobile != blank
      assign video_mobile_url = section.settings.video_mobile.sources[1].url | default: section.settings.video_mobile.sources[0].url
    elsif section.settings.video_url_mobile != blank
      assign video_mobile_url = section.settings.video_url_mobile
    else
      assign video_mobile_url = video_desktop_url
    endif
  endif

  assign enable_custom_mobile_height = false
  assign custom_mobile_height = section.settings.custom_mobile_height | default: 667 | at_least: 1
  if is_video == false and section.settings.enable_custom_mobile_height
    assign enable_custom_mobile_height = true
  endif

  assign has_controls = false
  if is_video and video_desktop_url != blank and section.settings.show_video_controls
    assign has_controls = true
  endif

  # Only the first section in the template is the LCP candidate. Later heroes
  # must not compete with it for bandwidth, so their image lazy-loads.
  # section.index is 1-based and only set inside JSON templates and section
  # groups; when it is missing, keep eager so nothing above the fold regresses.
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.index == blank or section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
-%}

<hero-fullscreen
  class="hero-fullscreen js-hero-fullscreen{% if enable_custom_mobile_height %} hero-fullscreen--custom-mobile-height{% endif %}{% if has_controls %} hero-fullscreen--has-controls{% endif %}"
  id="hero-{{ section.id }}"
  data-header-mode="{{ header_mode }}"
  data-text-color="{{ text_color }}"
  data-content-vertical-alignment="{{ content_vertical_alignment }}"
  style="--hero-background-color: {{ background_color }}; --hero-content-text-color: {{ text_color }};{% if enable_custom_mobile_height %} --hero-custom-mobile-height: {{ custom_mobile_height }}px;{% endif %}"
  data-autoplay="{{ section.settings.video_autoplay }}"
  data-show-controls="{{ section.settings.show_video_controls }}"
>
  <div class="hero-fullscreen__media global-media">
    {%- if is_video -%}
      {%- if video_desktop_url != blank -%}
        <video
          class="hero-fullscreen__video js-hero-video"
          {% if section.settings.video_autoplay %}autoplay{% endif %}
          loop
          muted
          playsinline
          preload="metadata"
          {% if section.settings.image_desktop != blank %}
            poster="{{ section.settings.image_desktop | image_url: width: 3840 }}"
          {% endif %}
        >
          <source src="{{ video_mobile_url }}" media="(max-width: 900px)" type="video/mp4">
          <source src="{{ video_desktop_url }}" type="video/mp4">
        </video>
      {%- endif -%}

    {%- else -%}
      {%- if section.settings.image_desktop != blank -%}
        {%- render 'picture',
          image_desktop: section.settings.image_desktop,
          image_mobile: section.settings.image_mobile,
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          class: 'hero-fullscreen__image',
          sizes: '100vw'
        -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_overlay -%}
    {%- liquid
      assign overlay_opacity = section.settings.overlay_opacity | default: 40 | divided_by: 100.0
      assign overlay_color = section.settings.overlay_color | default: '#000000'
    -%}
    <div
      class="hero-fullscreen__overlay"
      style="background: linear-gradient(0deg, {{ overlay_color | color_modify: 'alpha', overlay_opacity }} 0%, {{ overlay_color | color_modify: 'alpha', overlay_opacity }} 100%);"
    ></div>
  {%- endif -%}

  {%- if video_desktop_url != blank and section.settings.show_video_controls -%}
    <div class="hero-fullscreen__control-scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero-fullscreen__content">
    {%- if section.settings.heading != blank -%}
      {%- liquid
        assign heading_size = section.settings.heading_font_size | default: 'text-reg-14'
        assign heading_classes = 'hero-fullscreen__heading ' | append: heading_size
        if section.settings.heading_uppercase
          assign heading_classes = heading_classes | append: ' uppercase'
        endif
      -%}
      <h2 class="{{ heading_classes }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="hero-fullscreen__description rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      {%- liquid
        assign cta_size = section.settings.cta_font_size | default: 'text-reg-14'
        assign cta_classes = 'hero-fullscreen__cta ' | append: cta_size
        if section.settings.cta_uppercase
          assign cta_classes = cta_classes | append: ' uppercase'
        endif
      -%}
      {%- if section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="hero-fullscreen__link {{ cta_classes }}">
          {{ section.settings.cta_text }}
        </a>
      {%- else -%}
        <p class="{{ cta_classes }}">
          {{ section.settings.cta_text }}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if video_desktop_url != blank and section.settings.show_video_controls -%}
    <div class="hero-fullscreen__controls js-video-controls">
      <div class="hero-fullscreen__timeline">
        <span class="hero-fullscreen__time js-current-time">00:00</span>

        <div class="hero-fullscreen__timeline-wrap js-timeline-wrap">
          <div class="hero-fullscreen__timeline-track"></div>
          <div class="hero-fullscreen__timeline-buffered js-timeline-buffered"></div>
          <div class="hero-fullscreen__timeline-played js-timeline-played"></div>
          <input
            class="hero-fullscreen__timeline-range js-timeline-range"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="Seek video"
          >
        </div>

        <span class="hero-fullscreen__time hero-fullscreen__time-end js-duration">00:00</span>
      </div>

      <div class="hero-fullscreen__actions">
        <button
          type="button"
          class="hero-fullscreen__control-button js-playback-toggle"
          aria-label="Play video"
        ></button>
        <button
          type="button"
          class="hero-fullscreen__control-button js-mute-toggle"
          aria-label="Unmute video"
        ></button>
      </div>
    </div>
  {%- elsif video_desktop_url != blank -%}
    <button
      type="button"
      class="hero-fullscreen__playback-toggle js-playback-toggle"
      aria-label="{% if section.settings.video_autoplay %}Pause{% else %}Play{% endif %} video"
    >
      {%- render 'icons', icon: 'pause', class: 'icon-pause js-icon-pause' -%}
      {%- render 'icons', icon: 'play', class: 'icon-play js-icon-play' -%}
    </button>
  {%- endif -%}
</hero-fullscreen>

{% schema %}
{
  "name": "Hero Fullscreen",
  "tag": "section",
  "class": "shopify-section-hero-fullscreen js-section-header-contrast",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Recommended: 3840 x 2160 px (2x Retina, 16:9 aspect ratio).",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Recommended: 1500 x 2000 px (2x–3x Retina, 3:4 / 9:16 aspect ratio).",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_height",
      "label": "Use custom mobile height",
      "info": "Applies at 768px and below for image media only.",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "number",
      "id": "custom_mobile_height",
      "label": "Custom mobile height (px)",
      "info": "Minimum 1px.",
      "default": 667,
      "visible_if": "{{ section.settings.media_type == 'image' and section.settings.enable_custom_mobile_height == true }}"
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Desktop Shopify video",
      "info": "Recommended: 3840 x 2160 px (4K) or 1920 x 1080 px (Full HD), 16:9 aspect ratio. MP4 format.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile Shopify video",
      "info": "Recommended: 1080 x 1920 px (9:16) or 1080 x 1440 px (3:4 portrait). Uses desktop video when left empty. MP4 format.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_url_desktop",
      "label": "Desktop external video URL (MP4 direct link)",
      "info": "Recommended: 3840 x 2160 px (4K) or 1920 x 1080 px (16:9). Used when no desktop Shopify video is selected.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Mobile external video URL (MP4 direct link)",
      "info": "Recommended: 1080 x 1920 px (9:16) or 1080 x 1440 px (3:4). Used when no mobile Shopify video is selected. Falls back to desktop video when empty.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video",
      "info": "Automatically plays the muted video in a loop.",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_video_controls",
      "label": "Show video controls",
      "info": "Shows the timeline, time, play/pause and mute controls. When disabled, the compact play/pause button is used.",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.show_overlay == true }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_overlay == true }}"
    },
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hero background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content Position"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom",
      "info": "Choose where the full content group appears vertically in the hero."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Resort 2027"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
    },
    {
      "type": "header",
      "content": "Call To Action"
    },
    {
      "type": "inline_richtext",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "select",
      "id": "cta_font_size",
      "label": "CTA font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "cta_uppercase",
      "label": "Uppercase",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero Fullscreen"
    }
  ]
}
{% endschema %}
