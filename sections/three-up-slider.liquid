{%- liquid
  assign header_mode = section.settings.header_contrast_mode | default: 'light'

  assign valid_block_count = 0
  for block in section.blocks
    assign block_desktop_image = block.settings.image_desktop | default: block.settings.desktop_image
    assign block_desktop_video = block.settings.desktop_video | default: block.settings.video_desktop
    assign block_desktop_video_url = block.settings.desktop_video_url | default: block.settings.video_desktop_url
    assign block_video_url = blank

    if block_desktop_video != blank
      assign block_video_url = block_desktop_video.sources[1].url | default: block_desktop_video.sources[0].url
    elsif block_desktop_video_url != blank
      assign block_video_url = block_desktop_video_url
    endif

    if block_video_url != blank or block_desktop_image != blank
      assign valid_block_count = valid_block_count | plus: 1
    endif
  endfor
-%}

{%- if valid_block_count > 0 -%}
  {{- 'three-up-slider.css' | asset_url | stylesheet_tag -}}
  <script src="{{ 'three-up-slider.js' | asset_url }}" defer="defer"></script>

  <three-up-slider
    class="three-up-slider"
    data-header-mode="{{ header_mode }}"
  >
    <div>
      <div class="js-swiper three-up-slider__swiper swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign desktop_image = block.settings.image_desktop | default: block.settings.desktop_image
              assign mobile_image = block.settings.image_mobile | default: block.settings.mobile_image
              assign desktop_video = block.settings.desktop_video | default: block.settings.video_desktop
              assign mobile_video = block.settings.mobile_video | default: block.settings.video_mobile

              assign desktop_video_url = blank
              assign mobile_video_url = blank

              if desktop_video != blank
                assign desktop_video_url = desktop_video.sources[1].url | default: desktop_video.sources[0].url
              elsif block.settings.desktop_video_url != blank
                assign desktop_video_url = block.settings.desktop_video_url
              elsif block.settings.video_desktop_url != blank
                assign desktop_video_url = block.settings.video_desktop_url
              endif

              if mobile_video != blank
                assign mobile_video_url = mobile_video.sources[1].url | default: mobile_video.sources[0].url
              elsif block.settings.mobile_video_url != blank
                assign mobile_video_url = block.settings.mobile_video_url
              elsif block.settings.video_mobile_url != blank
                assign mobile_video_url = block.settings.video_mobile_url
              else
                assign mobile_video_url = desktop_video_url
              endif

              if mobile_image == blank
                assign mobile_image = desktop_image
              endif

              assign has_video = false
              assign has_image = false

              if desktop_video_url != blank
                assign has_video = true
              elsif desktop_image != blank
                assign has_image = true
              endif

              if has_video == false and has_image == false
                continue
              endif

              assign block_title = block.settings.title
            -%}
            <div class="js-slide swiper-slide" {{ block.shopify_attributes }}>
              {%- if has_video -%}
                <video
                  class="three-up-slider__slide-video"
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  {% if desktop_image != blank %}
                    poster="{{ desktop_image | image_url: width: 1200 }}"
                  {% endif %}
                >
                  <source src="{{ mobile_video_url }}" media="(max-width: 767px)" type="video/mp4">
                  <source src="{{ desktop_video_url }}" type="video/mp4">
                </video>
              {%- elsif has_image -%}
                {%- render 'picture',
                  image_desktop: desktop_image,
                  image_mobile: mobile_image,
                  class: 'three-up-slider__slide-image'
                -%}
              {%- endif -%}

              {%- if block_title != blank -%}
                {%- liquid
                  assign title_size = block.settings.font_size | default: 'text-reg-14'
                  assign title_classes = 'three-up-slider__slide-title ' | append: title_size
                  if block.settings.uppercase
                    assign title_classes = title_classes | append: ' uppercase'
                  endif
                -%}
                <p class="{{ title_classes }}">{{ block_title }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </three-up-slider>
{%- endif -%}

{%- schema -%}
{
  "name": "Three Up Slider",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header contrast mode",
      "options": [
        {
          "value": "light",
          "label": "Light Header (White text for dark background)"
        },
        {
          "value": "dark",
          "label": "Dark Header (Black text for light background)"
        }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Media",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop image",
          "info": "Recommended: 1072 x 1520 px (2x Retina, 268:380 portrait aspect ratio). Used as image or video poster."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Recommended: 536 x 760 px (or 804 x 1140 px for 3x Retina, 268:380 aspect ratio). Uses desktop image when left empty."
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Uses desktop video when left empty."
        },
        {
          "type": "text",
          "id": "desktop_video_url",
          "label": "Desktop external MP4 URL",
          "info": "Used when no desktop Shopify video is selected."
        },
        {
          "type": "text",
          "id": "mobile_video_url",
          "label": "Mobile external MP4 URL",
          "info": "Used when no mobile Shopify video is selected. Falls back to desktop video when empty."
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "font_size",
          "label": "Font size",
          "options": [
            {
              "value": "text-reg-14",
              "label": "14px"
            },
            {
              "value": "text-reg-10",
              "label": "10px"
            }
          ],
          "default": "text-reg-14"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Up Slider",
      "settings": {
        "header_contrast_mode": "dark"
      },
      "blocks": [
        {
          "type": "image",
          "settings": {
            "image_desktop": "shopify://shop_images/Image.jpg",
            "image_mobile": "shopify://shop_images/Image.jpg",
            "title": "Fabric lorem Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim."
          }
        },
        {
          "type": "image",
          "settings": {
            "image_desktop": "shopify://shop_images/Image_1.jpg",
            "image_mobile": "shopify://shop_images/Image_1.jpg",
            "title": "Sleeve Construction lorem Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
          }
        }
      ]
    }
  ]
}
{%- endschema -%}
