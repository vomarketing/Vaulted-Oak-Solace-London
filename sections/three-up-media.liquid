{%- liquid
  assign header_mode = section.settings.header_contrast_mode | default: 'light'

  assign media_type = section.settings.media_type
  assign image_desktop = section.settings.image_desktop
  assign image_mobile = section.settings.image_mobile
  assign video_desktop = section.settings.video_desktop
  assign video_mobile = section.settings.video_mobile | default: video_desktop
  assign media_description = section.settings.media_description

  assign has_section_media = false
  if media_type == 'image' and image_desktop != blank
    assign has_section_media = true
  elsif media_type == 'video' and video_desktop != blank
    assign has_section_media = true
  endif
-%}

{%- if has_section_media -%}
  {{- 'three-up-media.css' | asset_url | stylesheet_tag -}}

  <div
    class="three-up-media"
    data-header-mode="{{ header_mode }}"
  >
    <div class="three-up-media__inner">
      {%- if media_type == 'image' -%}
        {%- render 'picture',
          image_desktop: image_desktop,
          image_mobile: image_mobile,
          class: 'three-up-media__image'
        -%}
      {%- else -%}
        {%- liquid
          assign video_desktop_url = blank
          assign video_mobile_url = blank
          if video_desktop != blank
            assign video_desktop_url = video_desktop.sources[1].url | default: video_desktop.sources[0].url
          elsif section.settings.video_desktop_url != blank
            assign video_desktop_url = section.settings.video_desktop_url
          endif

          if video_mobile != blank
            assign video_mobile_url = video_mobile.sources[1].url | default: video_mobile.sources[0].url
          elsif section.settings.video_mobile_url != blank
            assign video_mobile_url = section.settings.video_mobile_url
          else
            assign video_mobile_url = video_desktop_url
          endif
        -%}
        <div class="three-up-media__video-wrapper">
          <video
            class="three-up-media__video js-section-video"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            {% if image_desktop != blank %}
              poster="{{ image_desktop | image_url: width: 1200 }}"
            {% endif %}
          >
            <source src="{{ video_mobile_url }}" media="(max-width: 767px)" type="video/mp4">
            <source src="{{ video_desktop_url }}" type="video/mp4">
          </video>
        </div>
      {%- endif -%}
      {%- if media_description != blank -%}
        {%- liquid
          assign desc_size = section.settings.description_font_size | default: 'text-reg-14'
          assign desc_classes = 'three-up-media__description ' | append: desc_size
          if section.settings.description_uppercase
            assign desc_classes = desc_classes | append: ' uppercase'
          endif
        -%}
        <p class="{{ desc_classes }}">{{ media_description }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- schema -%}
{
  "name": "Three Up Media",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Recommended: 2356 x 1504 px (2x Retina, 714:456 landscape aspect ratio). Used as image or video poster."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Recommended: 630 x 986 px (2x Retina, 275:431 portrait aspect ratio). Uses desktop image when left empty."
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Desktop video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video",
      "info": "Uses desktop video when left empty.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_desktop_url",
      "label": "Desktop external MP4 URL",
      "info": "Used when no desktop Shopify video is selected.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_mobile_url",
      "label": "Mobile external MP4 URL",
      "info": "Used when no mobile Shopify video is selected. Falls back to desktop video when empty.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "inline_richtext",
      "id": "media_description",
      "label": "Media description"
    },
    {
      "type": "select",
      "id": "description_font_size",
      "label": "Description font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "description_uppercase",
      "label": "Description uppercase",
      "default": false
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header contrast mode",
      "options": [
        {
          "value": "light",
          "label": "Light Header (White text for dark background)"
        },
        {
          "value": "dark",
          "label": "Dark Header (Black text for light background)"
        }
      ],
      "default": "light"
    }
  ],
  "presets": [
    {
      "name": "Three Up Media",
      "settings": {
        "media_type": "video",
        "image_desktop": "shopify://shop_images/Image_2.jpg",
        "image_mobile": "shopify://shop_images/Image_3.jpg",
        "video_desktop": "shopify://files/videos/tripic3_no_bleed3.mp4",
        "video_mobile": "shopify://files/videos/jca_edit2.mp4",
        "media_description": "Resort 2027 lorem Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.",
        "header_contrast_mode": "dark"
      }
    }
  ]
}
{%- endschema -%}
