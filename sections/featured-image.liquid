<style>
  {{ 'featured-image.css' | inline_asset_content }}
</style>

{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign header_mode = section.settings.header_contrast_mode | default: 'dark'
  assign enable_custom_size = section.settings.enable_custom_size | default: false
  assign custom_width = section.settings.custom_width | default: 529 | at_least: 1
  assign custom_height = section.settings.custom_height | default: 750 | at_least: 1
  assign enable_custom_spacing = section.settings.enable_custom_spacing | default: false
  assign custom_padding_top = section.settings.custom_padding_top | default: 0 | at_least: 0
  assign custom_padding_bottom = section.settings.custom_padding_bottom | default: 0 | at_least: 0
  assign image_sizes = '(min-width: 1600px) 1180px, (min-width: 910px) 977px, (min-width: 768px) 596px, calc(100vw - 50px)'

  if enable_custom_size
    assign image_sizes = '(min-width: 980px) ' | append: custom_width | append: 'px, (min-width: 768px) 596px, calc(100vw - 50px)'
  endif

  assign text_left_size = section.settings.text_left_font_size | default: 'text-reg-14'
  assign text_left_classes = text_left_size
  if section.settings.text_left_uppercase
    assign text_left_classes = text_left_classes | append: ' uppercase'
  endif

  assign text_right_size = section.settings.text_right_font_size | default: 'text-reg-14'
  assign text_right_classes = text_right_size
  if section.settings.text_right_uppercase
    assign text_right_classes = text_right_classes | append: ' uppercase'
  endif
-%}

<featured-image
  class="featured-image{% if enable_custom_size %} featured-image--custom-size{% endif %}{% if enable_custom_spacing %} featured-image--custom-spacing{% endif %}"
  id="FeaturedImage-{{ section.id }}"
  data-header-mode="{{ header_mode }}"
  {%- if enable_custom_size or enable_custom_spacing %}
    style="{% if enable_custom_size %}--featured-image-custom-width: {{ custom_width }}px; --featured-image-custom-height: {{ custom_height }}px;{% endif %}{% if enable_custom_spacing %} --featured-image-custom-padding-top: {{ custom_padding_top }}px; --featured-image-custom-padding-bottom: {{ custom_padding_bottom }}px;{% endif %}"
  {%- endif %}
>
  <div class="featured-image__inner">
    {%- if section.settings.text_left != blank -%}
      <div class="featured-image__text featured-image__text--mobile-top {{ text_left_classes }}">
        {%- if section.settings.text_left_link != blank -%}
          <a href="{{ section.settings.text_left_link }}">
            {{ section.settings.text_left }}
          </a>
        {%- else -%}
          {{ section.settings.text_left }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if desktop_image != blank -%}
      {%- if section.settings.image_link != blank -%}
        <a
          href="{{ section.settings.image_link }}"
          class="featured-image__media"
        >
      {%- else -%}
        <div class="featured-image__media">
      {%- endif -%}

        {%- render 'picture',
          image_desktop: desktop_image,
          image_mobile: mobile_image,
          class: 'featured-image__image',
          picture_class: 'featured-image__picture',
          breakpoint: '1199px',
          sizes: image_sizes,
          sizes_mobile: image_sizes
        -%}

      {%- if section.settings.image_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.text_content != blank -%}
      <div class="featured-image__text-content rte text-reg-12">
        {{ section.settings.text_content }}
      </div>
    {%- endif -%}

    {%- if section.settings.text_left != blank or section.settings.text_right != blank -%}
      <div class="featured-image__content">
        {%- if section.settings.text_left != blank -%}
          <div class="featured-image__text featured-image__text--desktop {{ text_left_classes }}">
            {%- if section.settings.text_left_link != blank -%}
              <a href="{{ section.settings.text_left_link }}">
                {{ section.settings.text_left }}
              </a>
            {%- else -%}
              {{ section.settings.text_left }}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.text_right != blank -%}
          <div class="featured-image__text {{ text_right_classes }}">
            {%- if section.settings.text_right_link != blank -%}
              <a href="{{ section.settings.text_right_link }}">
                {{ section.settings.text_right }}
              </a>
            {%- else -%}
              {{ section.settings.text_right }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</featured-image>

{% schema %}
{
  "name": "Featured Image",
  "tag": "section",
  "class": "section-featured-image js-section-header-contrast",
  "settings": [
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_size",
      "label": "Use custom desktop size",
      "info": "Applies at 980px and above. Mobile sizing stays unchanged.",
      "default": false
    },
    {
      "type": "number",
      "id": "custom_width",
      "label": "Custom width (px)",
      "default": 529,
      "visible_if": "{{ section.settings.enable_custom_size == true }}"
    },
    {
      "type": "number",
      "id": "custom_height",
      "label": "Custom height (px)",
      "default": 750,
      "visible_if": "{{ section.settings.enable_custom_size == true }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_spacing",
      "label": "Use custom desktop spacing",
      "info": "Applies at 980px and above. Each Featured Image section can use different values.",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_spacing == true }}"
    },
    {
      "type": "range",
      "id": "custom_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_custom_spacing == true }}"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Recommended: 2360 x 1506 px (2x Retina, 1180:753 landscape aspect ratio)."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended: 1192 x 1686 px (2x Retina, 596:843 portrait aspect ratio). Uses desktop image when left empty."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text content"
    },
    {
      "type": "inline_richtext",
      "id": "text_left",
      "label": "First text",
      "default": "The Annie"
    },
    {
      "type": "url",
      "id": "text_left_link",
      "label": "First text link"
    },
    {
      "type": "select",
      "id": "text_left_font_size",
      "label": "First text font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "text_left_uppercase",
      "label": "First text uppercase",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "text_right",
      "label": "Second text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "text_right_link",
      "label": "Second text link"
    },
    {
      "type": "select",
      "id": "text_right_font_size",
      "label": "Second text font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14"
    },
    {
      "type": "checkbox",
      "id": "text_right_uppercase",
      "label": "Second text uppercase",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured Image"
    }
  ]
}
{% endschema %}
