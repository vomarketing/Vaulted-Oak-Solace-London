<style>
  {{ 'featured-image.css' | inline_asset_content }}
</style>

{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign header_mode = section.settings.header_contrast_mode | default: 'dark'
  assign image_orientation = section.settings.image_orientation | default: 'landscape'
  assign is_portrait = false
  assign image_sizes = '(min-width: 1600px) 1180px, (min-width: 910px) 977px, (min-width: 768px) 596px, calc(100vw - 50px)'

  if image_orientation == 'portrait'
    assign is_portrait = true
    assign image_sizes = '(min-width: 768px) 529px, calc(100vw - 50px)'
  endif

  assign text_left_size = section.settings.text_left_font_size | default: 'text-reg-14'
  assign text_left_classes = text_left_size
  if section.settings.text_left_uppercase
    assign text_left_classes = text_left_classes | append: ' uppercase'
  endif

  assign text_right_size = section.settings.text_right_font_size | default: 'text-reg-14'
  assign text_right_classes = text_right_size
  if section.settings.text_right_uppercase
    assign text_right_classes = text_right_classes | append: ' uppercase'
  endif
-%}

<featured-image
  class="featured-image featured-image--{{ image_orientation }}"
  id="FeaturedImage-{{ section.id }}"
  data-header-mode="{{ header_mode }}"
>
  <div class="featured-image__inner">
    {%- unless is_portrait -%}
      {%- if section.settings.text_left != blank -%}
        <div class="featured-image__text featured-image__text--mobile-top {{ text_left_classes }}">
          {%- if section.settings.text_left_link != blank -%}
            <a href="{{ section.settings.text_left_link }}">
              {{ section.settings.text_left }}
            </a>
          {%- else -%}
            {{ section.settings.text_left }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endunless -%}

    {%- if desktop_image != blank -%}
      {%- if section.settings.image_link != blank -%}
        <a
          href="{{ section.settings.image_link }}"
          class="featured-image__media"
        >
      {%- else -%}
        <div class="featured-image__media">
      {%- endif -%}

        {%- render 'picture',
          image_desktop: desktop_image,
          image_mobile: mobile_image,
          class: 'featured-image__image',
          picture_class: 'featured-image__picture',
          breakpoint: '1199px',
          sizes: image_sizes,
          sizes_mobile: image_sizes
        -%}

      {%- if section.settings.image_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if is_portrait -%}
      {%- if section.settings.text_content != blank -%}
        <div class="featured-image__portrait-content rte text-reg-14">
          {{ section.settings.text_content }}
        </div>
      {%- endif -%}
    {%- elsif section.settings.text_left != blank or section.settings.text_right != blank -%}
        <div class="featured-image__content">
          {%- if section.settings.text_left != blank -%}
            <div class="featured-image__text featured-image__text--desktop {{ text_left_classes }}">
              {%- if section.settings.text_left_link != blank -%}
                <a href="{{ section.settings.text_left_link }}">
                  {{ section.settings.text_left }}
                </a>
              {%- else -%}
                {{ section.settings.text_left }}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.text_right != blank -%}
            <div class="featured-image__text {{ text_right_classes }}">
              {%- if section.settings.text_right_link != blank -%}
                <a href="{{ section.settings.text_right_link }}">
                  {{ section.settings.text_right }}
                </a>
              {%- else -%}
                {{ section.settings.text_right }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
    {%- endif -%}
  </div>
</featured-image>

{% schema %}
{
  "name": "Featured Image",
  "tag": "section",
  "class": "section-featured-image js-section-header-contrast",
  "settings": [
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_orientation",
      "label": "Image orientation",
      "options": [
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Recommended: 2360 x 1506 px (2x Retina, 1180:753 landscape aspect ratio)."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended: 1192 x 1686 px (2x Retina, 596:843 portrait aspect ratio). Uses desktop image when left empty."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "text_left",
      "label": "First text",
      "default": "The Annie",
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "url",
      "id": "text_left_link",
      "label": "First text link",
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "select",
      "id": "text_left_font_size",
      "label": "First text font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14",
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "checkbox",
      "id": "text_left_uppercase",
      "label": "First text uppercase",
      "default": false,
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "inline_richtext",
      "id": "text_right",
      "label": "Second text",
      "default": "Shop Now",
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "url",
      "id": "text_right_link",
      "label": "Second text link",
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "select",
      "id": "text_right_font_size",
      "label": "Second text font size",
      "options": [
        {
          "value": "text-reg-14",
          "label": "14px"
        },
        {
          "value": "text-reg-12",
          "label": "12px"
        },
        {
          "value": "text-reg-10",
          "label": "10px"
        }
      ],
      "default": "text-reg-14",
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "checkbox",
      "id": "text_right_uppercase",
      "label": "Second text uppercase",
      "default": false,
      "visible_if": "{{ section.settings.image_orientation == 'landscape' }}"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text content",
      "visible_if": "{{ section.settings.image_orientation == 'portrait' }}"
    }
  ],
  "presets": [
    {
      "name": "Featured Image"
    }
  ]
}
{% endschema %}
