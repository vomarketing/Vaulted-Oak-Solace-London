{{ 'featured-image.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign header_mode = section.settings.header_contrast_mode | default: 'dark'
-%}

<featured-image
  class="featured-image"
  id="FeaturedImage-{{ section.id }}"
  data-header-mode="{{ header_mode }}"
>
  <div class="featured-image__inner">
    {%- if section.settings.text_left != blank -%}
      <div class="featured-image__text text-med-14 featured-image__text--mobile-top">
        {%- if section.settings.text_left_link != blank -%}
          <a href="{{ section.settings.text_left_link }}">
            {{ section.settings.text_left | escape }}
          </a>
        {%- else -%}
          {{ section.settings.text_left | escape }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if desktop_image != blank -%}
      {%- if section.settings.image_link != blank -%}
        <a
          href="{{ section.settings.image_link }}"
          class="featured-image__media"
        >
      {%- else -%}
        <div class="featured-image__media">
      {%- endif -%}

        {%- render 'picture',
          image_desktop: desktop_image,
          image_mobile: mobile_image,
          class: 'featured-image__image',
          picture_class: 'featured-image__picture',
          breakpoint: '1199px',
          sizes: '(min-width: 1600px) 1180px, (min-width: 910px) 977px, (min-width: 768px) 596px, calc(100vw - 50px)'
        -%}

      {%- if section.settings.image_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.text_left != blank or section.settings.text_right != blank -%}
      <div class="featured-image__content">
        {%- if section.settings.text_left != blank -%}
          <div class="featured-image__text text-med-14 featured-image__text--desktop">
            {%- if section.settings.text_left_link != blank -%}
              <a href="{{ section.settings.text_left_link }}">
                {{ section.settings.text_left | escape }}
              </a>
            {%- else -%}
              {{ section.settings.text_left | escape }}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.text_right != blank -%}
          <div class="featured-image__text text-med-14">
            {%- if section.settings.text_right_link != blank -%}
              <a href="{{ section.settings.text_right_link }}">
                {{ section.settings.text_right | escape }}
              </a>
            {%- else -%}
              {{ section.settings.text_right | escape }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</featured-image>

{% schema %}
{
  "name": "Featured Image",
  "tag": "section",
  "class": "section-featured-image js-section-header-contrast",
  "settings": [
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Uses desktop image when left empty."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text_left",
      "label": "First text",
      "default": "The Annie"
    },
    {
      "type": "url",
      "id": "text_left_link",
      "label": "First text link"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Second text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "text_right_link",
      "label": "Second text link"
    }
  ],
  "presets": [
    {
      "name": "Featured Image"
    }
  ]
}
{% endschema %}