{{ 'two-ups-image.css' | asset_url | stylesheet_tag }}

{% liquid
  assign header_mode = section.settings.header_contrast_mode | default: 'dark'
%}

<div
  class="two-ups-image"
  id="TwoUpsImage-{{ section.id }}"
  data-header-mode="{{ header_mode }}"
>
  <div class="two-ups-image__inner">
    {% for block in section.blocks %}
      {% liquid
        assign desktop_image = block.settings.desktop_image
        assign mobile_image = block.settings.mobile_image

        if mobile_image == blank
          assign mobile_image = desktop_image
        endif
      %}

      <div class="two-ups-image__item" {{ block.shopify_attributes }}>
        {% if block.settings.text != blank %}
          <div class="two-ups-image__text two-ups-image__text--mobile-top">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {% else %}
              {{ block.settings.text | escape }}
            {% endif %}
          </div>
        {% endif %}

        {% if desktop_image != blank %}
          {% if block.settings.link != blank %}
            <a class="two-ups-image__media" href="{{ block.settings.link }}">
          {% else %}
            <div class="two-ups-image__media">
          {% endif %}

            <picture>
              {% if mobile_image != blank %}
                <source
                  media="(max-width: 834px)"
                  srcset="
                    {{ mobile_image | image_url: width: 400 }} 400w,
                    {{ mobile_image | image_url: width: 600 }} 600w,
                    {{ mobile_image | image_url: width: 800 }} 800w,
                    {{ mobile_image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 834px) calc(100vw - 50px)"
                >
              {% endif %}

              {{
                desktop_image
                | image_url: width: 1600
                | image_tag:
                  class: 'two-ups-image__image',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: '(min-width: 1441px) 531px, (min-width: 835px) 440px, (min-width: 403px) 335px, 236px'
              }}
            </picture>

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="two-ups-image__text two-ups-image__text--default">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {% else %}
              {{ block.settings.text | escape }}
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Two Ups Image",
  "tag": "section",
  "class": "section-two-ups-image js-section-header-contrast",
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "Color & Contrast"
    },
    {
      "type": "select",
      "id": "header_contrast_mode",
      "label": "Header colour scheme over this section",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Uses desktop image when left empty."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two Ups Image",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "The Delano"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
