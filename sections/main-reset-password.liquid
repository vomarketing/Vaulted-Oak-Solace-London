<section class="acc-Auth acc-Auth-activateAccount">
  <div class="acc-Auth_Column">
    <div class="acc-Auth_Content">
      <div class="acc-Auth_Inner lyt-Container">
        <header class="acc-Auth_Header">
          {%- capture title -%}{{ 'customer.reset_password.reset_password' | t }}{%- endcapture -%}
          {%- capture subtitle -%}{{ 'customer.reset_password.text' | t }}{%- endcapture -%}
          {%- render 'account-header', title: title, subtitle: subtitle -%}
        </header>

        <div class="acc-Auth_Body">
          {%- form 'reset_customer_password', class: 'frm-Form' -%}

            <div class="val-Validation val-Validation-error">
              {%- for field in form.errors -%}
                <p class="val-Validation_Text">{{ form.errors.messages[field] }}</p>
              {%- endfor -%}
            </div>

            <div class="frm-Form_Row">
              <label
                class="frm-Form_Label util-ScreenReaderOnly"
                for="ResetPassword"
              >
                {{ 'customer.reset_password.password' | t }}
              </label>
              <input
                class="frm-Form_Input frm-Form_Input-white{% if form.errors contains 'password' %} frm-Form_Input frm-Form_Input-error{% endif %}"
                type="password"
                name="customer[password]"
                id="ResetPassword"
                placeholder="{{ 'customer.reset_password.password' | t }}"
              />
            </div>

            <div class="frm-Form_Row">
              <label
                class="frm-Form_Label util-ScreenReaderOnly"
                for="PasswordConfirmation"
              >
                {{ 'customer.reset_password.confirm_password' | t }}
              </label>
              <input
                class="frm-Form_Input frm-Form_Input-white{% if form.errors contains 'password_confirmation' %} frm-Form_Input frm-Form_Input-error{% endif %}"
                type="password"
                name="customer[password_confirmation]"
                id="PasswordConfirmation"
                placeholder="{{ 'customer.reset_password.confirm_password' | t }}"
              />
            </div>

            <div class="frm-Form_Row">
              <button class="frm-Form_Button frm-Form_Button-gappy frm-Form_Button-white" type="submit">
                <span class="frm-Form_ButtonText">{{ 'customer.reset_password.reset' | t }}</span>

                <span class="frm-Form_ButtonIcon">
                  {%- render 'bao-arrow' -%}
                </span>
              </button>
            </div>
          {%- endform -%}

          <footer class="frm-Form_Footer">
            <a
              class="frm-Form_Link"
              href="{{ shop.url }}"
            >
              {{ 'customer.reset_password.cancel' | t }}
            </a>
          </footer>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main reset password",
  "settings": []
}
{% endschema %}
