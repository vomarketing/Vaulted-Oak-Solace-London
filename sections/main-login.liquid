<section
  class="acc-Auth"
  data-module="login"
  data-login-active-column="login"
  data-login-active-trigger-class="acc-Auth_Button-active"
  data-login-active-column-class="acc-Auth_Column-active"
>
  <div class="acc-Auth_Buttons">
    <button
      class="acc-Auth_Button acc-Auth_Button-active"
      data-el="login.trigger"
      data-login-column="login"
    >
      {{ 'customer.login.log_in' | t }}
    </button>

    <button class="acc-Auth_Button" data-el="login.trigger" data-login-column="register">
      {{ 'customer.login.new_account' | t }}
    </button>
  </div>

  <div
    class="acc-Auth_Column acc-Auth_Column-white acc-Auth_Column-active"
    data-el="login.column"
    data-login-column="login"
  >
    <div class="acc-Auth_Content acc-Auth_Content-login">
      <div class="acc-Auth_Body">
        <div class="acc-Auth_Form acc-Auth_Form-login" data-login-form>

          <header class="acc-Auth_Header">
            <h1 class="acc-Auth_Title fz-25_33">
              {{ 'customer.login.login' | t }}
            </h1>

            <p class="acc-Auth_Text acc-Auth_Text-login">
              {{ 'customer.login.text' | t }}
            </p>
          </header>

          {%- form 'customer_login', class: 'frm-Form' -%}
            <div class="frm-Form_Row">
              <label
                class="frm-Form_Label"
                for="LogInCustomerEmail"
              >
                {{ 'customer.login.email_address' | t }}
              </label>

              <input
                class="frm-Form_Input frm-Form_Input-whiteLogin"
                type="email"
                name="customer[email]"
                id="LogInCustomerEmail"
                placeholder="{{ 'customer.login.email_address' | t }}"
                required
              >
            </div>

            <div class="frm-Form_Row">
              <label
                class="frm-Form_Label"
                for="LogInCustomerPassword"
              >
                {{ 'customer.login.password' | t }}
              </label>

              <input
                class="frm-Form_Input frm-Form_Input-whiteLogin"
                type="password"
                name="customer[password]"
                id="LogInCustomerPassword"
                placeholder="{{ 'customer.login.password' | t }}"
                required
              >
            </div>

            {%- if form.errors and template.name == 'login' -%}
              <div class="val-Validation val-Validation-error val-Validation-spacer">
                {%- for field in form.errors -%}
                  <p class="val-Validation_Text">{{ form.errors.messages[field] }}</p>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="frm-Form_Row frm-Form_Row-spacer">
                <span class="frm-Form_Spacer"></span>
              </div>
            {%- endif -%}
            <div class="frm-Form_Row frm-Form_Row-spacer">
              <span class="frm-Form_Spacer"></span>
            </div>

            <div class="frm-Form_Row frm-Form_Row-gappy">
              <button class="frm-Form_Button frm-Form_Button-blkBorder" type="submit">
                <span class="frm-Form_ButtonText">{{ 'pages.contact.submit' | t }}</span>

                <span class="frm-Form_ButtonIcon">
                {%- render 'bao-arrow' -%}
              </span>
              </button>
            </div>

            <div class="frm-Form_Row frm-Form_Row-gappyish">
              <a class="frm-Form_Link" href="#recover"
                 data-recover-toggle>{{ 'customer.login.forgot_password' | t }}</a>
            </div>
          {%- endform -%}
        </div>

        <div class="acc-Auth_Form acc-Auth_Form-reset util-Hide" data-recover-form>
          <header class="acc-Auth_Header">
            <h1 class="acc-Auth_Title fz-25_33">
              {{ 'customer.login.reset_password' | t }}
            </h1>

            <p class="acc-Auth_Text acc-Auth_Text-login">
              {{ 'customer.login.reset_password_text' | t }}
            </p>
          </header>

          {%- form 'recover_customer_password', class: 'frm-Form acc-Login_Form' -%}
            {%- if form.posted_successfully? -%}
              <div class="val-Validation val-Validation-success">
                <p class="val-Validation_Text util-Hide reset-password-success" data-form-state></p>
              </div>
            {%- endif -%}

            <div class="frm-Form_Row">
              <label class="frm-Form_Label util-ScreenReaderOnly"
                     for="RecoverEmail">{{ 'customer.login.email_address' | t }}</label>
              <input class="frm-Form_Input frm-Form_Input-whiteLogin" type="email" name="email" id="RecoverEmail"
                     placeholder="{{ 'customer.login.email_address' | t }}" spellcheck="false" autocomplete="off"
                     autocapitalize="off" required/>
            </div>

            {%- if form.errors -%}
              <div class="val-Validation val-Validation-error val-Validation-spacer">
                {%- for field in form.errors -%}
                  <p class="val-Validation_Text">{{ form.errors.messages[field] }}</p>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="frm-Form_Row frm-Form_Row-spacer">
                <span class="frm-Form_Spacer"></span>
              </div>
            {%- endif -%}

            <div class="frm-Form_Row frm-Form_Row-spacer">
              <span class="frm-Form_Spacer"></span>
            </div>
            <div class="frm-Form_Row frm-Form_Row-spacer">
              <span class="frm-Form_Spacer"></span>
            </div>

            <div class="frm-Form_Row frm-Form_Row-gappy">
              <button class="frm-Form_Button frm-Form_Button-blkBorder" type="Submit"
                      value="{{ 'customer.login.reset' | t }}">
                <span class="frm-Form_ButtonText">{{ 'customer.login.reset' | t }}</span>

                <span class="frm-Form_ButtonIcon">
                  {%- render 'bao-arrow' -%}
                </span>
              </button>
            </div>

            <div class="frm-Form_Row frm-Form_Row-gappyish">
              <a class="frm-Form_Link btn-Button btn-Button-tertiary" href="#cancel"
                 data-recover-toggle>{{ 'customer.login.cancel' | t }}</a>
            </div>

          {%- endform -%}
        </div>
      </div>
    </div>
  </div>

  <div
    class="acc-Auth_Column acc-Auth_Column-black"
    data-el="login.column"
    data-login-column="register"
  >
    <div class="acc-Auth_Content">

      <header class="acc-Auth_Header acc-Auth_Header-shallow">
        <h1 class="acc-Auth_Title fz-25_33">
          {{ 'customer.register.register' | t }}
        </h1>

        <p class="acc-Auth-register">
          {{ 'customer.register.text' | t }}
        </p>
      </header>

      <div class="acc-AuthForm-register">
        {%- render 'account-register' -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main login",
  "settings": []
}
{% endschema %}
