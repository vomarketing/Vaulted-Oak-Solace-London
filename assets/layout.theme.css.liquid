/* Custom CSS */
.clc-List button.clc-Filters_Link {
    min-width: 110px;
    padding: 15px 15px;
    font-size: 14px;
}
.clc-Filters .clc-FiltersItem_Link {
    opacity: 1;
}
.clc-Filters .clc-FiltersItem_Link[aria-current=page] {
    text-decoration: underline;
}
.klv-QuickSearch .klv-Refine {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
}
.klv-QuickSearch .klv-Refine .klv-Refine_Group[data-for="tags"],
.klv-QuickSearch .klv-Suggestions .klv-Suggestions_Categories {
    order: 1;
    display: none !important;
}
