.btn.btn--Primary {
    position: relative;
    padding: 14px 20px;
    text-align: left;
    border: 1px solid #abacad;
    border-radius: 0;
    color: #000;
    overflow: hidden;
    transition: border .4s ease,color .3s ease;
    display: inline-block;
    width: auto;
    text-transform: uppercase;
    font-family: var(--Font_Family-lacrima);
    font-size: 13px;
    line-height: 1;
    min-width: 150px;
    text-align: center;
    vertical-align: top;
}
.btn.btn--Primary:hover {
    border-color: #000;
}

.hd-Nav_ChildLink[href="/collections/online-archive-sale"],
.drw-Nav_Link[href="/collections/online-archive-sale"] {
    color: red;
}

/* ==== */
.template-index.thm-Dark .hd-Header a.hd-Header_Logo {
    display: none;
}
.template-index.thm-Dark .ft-Footer a.ft-Footer_Logo {
    display: none;
}
.template-index.thm-Dark footer.ft-Footer {
    padding-block: 100px 50px;
}

.hd-Header_Body {
    align-items: center;
}

@media (min-width: 1201px) {
    .hd-Header_Logo {
        --Logo_Width: 220px;
        --Logo_Height: 30px;
    }
}
@media only screen and (max-width: 767px) {
    .template-index.thm-Dark footer.ft-Footer {
        padding-block: 30px 50px;
    } 
    .sec-MediaGrid_Title{
        margin:unset;
    }
}